  dueDate          DateTime
  subtotalCents    Int                      @default(0)
  taxCents         Int                      @default(0)
  totalCents       Int                      @default(0)
  amountPaidCents  Int                      @default(0)
  balanceDueCents  Int                      @default(0)
  paymentMethodId  String?
  paidAt           DateTime?
  failedAt         DateTime?
  voidedAt         DateTime?
  lastEmailStatus  String?
  lastEmailedAt    DateTime?
  pdfStorageKey    String?
  pdfGeneratedAt   DateTime?
  notes            String?
  metadata         Json?
  /// Set on onboarding sign-up invoices. UNIQUE so a retried checkout can never
  /// mint a second first-month invoice for the same submission (double charge).
  onboardingSubmissionId String? @unique
  /// "SYSTEM" = auto-generated by billing run | "MANUAL" = operator-created
  source           String?
  /// userId of operator who created this invoice (null = system-generated)
  createdByUserId  String?
  /// Override billing recipient email for this invoice
  billingEmail     String?
  /// FK to TenantBillingProfile — set when this invoice was generated for a billing profile.
  billingProfileId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentMethod    PaymentMethod?           @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  billingProfile   TenantBillingProfile?    @relation(fields: [billingProfileId], references: [id], onDelete: SetNull)
  lineItems        BillingInvoiceLineItem[]
  transactions     PaymentTransaction[]
  events           BillingEventLog[]

  @@index([tenantId, status, dueDate])
  @@index([tenantId, periodStart, periodEnd])
  @@index([tenantId, source])
  @@index([tenantId, billingProfileId])
  @@index([createdAt])
}

