model Tenant {
  id                              String                            @id @default(cuid())
  name                            String
  /// Customer-facing business tenant vs. internal/test workspaces. Admin dropdowns default to CUSTOMER.
  kind                            TenantKind                        @default(CUSTOMER)
  /// Whether this customer was set up to be offered Yiddish. Asked once during
  /// the onboarding wizard. False means the language toggle never appears for
  /// anyone in the tenant, regardless of individual permissions.
  yiddishEnabled                  Boolean                           @default(false)
  isApproved                      Boolean                           @default(false)
  dailySmsCap                     Int                               @default(100)
  perSecondRate                   Float                             @default(1.0)
  firstCampaignRequiresApproval   Boolean                           @default(true)
  smsSendMode                     SmsSendMode                       @default(TEST)
  smsLiveEnabledAt                DateTime?
  smsLiveEnabledByUserId          String?
  dailySmsLimit                   Int                               @default(500)
  hourlySmsLimit                  Int                               @default(100)
  perSecondRateLimit              Int                               @default(5)
  maxCampaignSize                 Int                               @default(2000)
  smsSuspended                    Boolean                           @default(false)
  smsSuspendedReason              String?
  smsSuspendedAt                  DateTime?
  smsRoutingMode                  SmsProviderRoutingMode            @default(FAILOVER)
  smsPrimaryProvider              IntegrationProvider               @default(TWILIO)
  smsSecondaryProvider            IntegrationProvider?              @default(VOIPMS)
  smsProviderLock                 IntegrationProvider?
  smsProviderLockReason           String?
  smsProviderLockedAt             DateTime?
  smsProviderLockedByUserId       String?
  defaultSmsFromNumberId          String?
  defaultVoiceFromNumberId        String?
  numberPurchaseEnabled           Boolean                           @default(true)
  /// Per-tenant switch: when ON, this tenant's tenant-wide call viewers also see
  /// call history + recordings for extensions in OTHER tenants that are linked
  /// into this tenant via UserSipAccount rows (scoped to those extensions only).
  linkedSipCallVisibilityEnabled  Boolean                           @default(false)
  /// Per-tenant sign-in code (2FA-by-code, 2026-08-19). When ON, every user of
  /// this tenant who is not TOTP-enrolled must enter a one-time code sent by
  /// text or email after their password, unless they signed in from a device
  /// they chose to "remember" (TrustedLoginDevice, 90 days). Sessions issued
  /// under this switch expire after 90 days. OFF for every tenant until an
  /// administrator turns it on — nobody is affected on the day it ships.
  loginOtpRequired                Boolean                           @default(false)
  /// "EMAIL" | "SMS" | "EITHER" — which channels the code may go out on. SMS
  /// needs User.phone; a user with none is emailed even under "SMS".
  loginOtpChannel                 String                            @default("EITHER")
  smsSubscriptionRequired         Boolean                           @default(true)
  smsBillingEnforced              Boolean                           @default(true)
  webrtcEnabled                   Boolean                           @default(false)
  /// Send this tenant's softphones through Connect on 443 instead of straight
  /// to the PBX on 8089. Default TRUE since 2026-08-17 (owner's instruction):
  /// filtered/geo-blocked internet is the norm for our customers, 443 is the
  /// one port that is never blocked, and it needs nothing installed on the
  /// device. ⛔ A non-null `sipWsUrl` OVERRIDES this — see resolveWebrtcConfig.
  webrtcRouteViaSbc               Boolean                           @default(true)
  sipWsUrl                        String?
  sipDomain                       String?
  iceServers                      Json?
  outboundProxy                   String?
  dtmfMode                        DtmfMode                          @default(RFC2833)
  turnRequiredForMobile           Boolean                           @default(false)
  turnValidationStatus            TurnValidationStatus              @default(UNKNOWN)
  turnValidatedAt                 DateTime?
  turnLastErrorCode               String?
  turnLastErrorAt                 DateTime?
  mediaReliabilityGateEnabled     Boolean                           @default(false)
  mediaTestStatus                 MediaTestStatus                   @default(UNKNOWN)
  mediaTestedAt                   DateTime?
  mediaLastErrorCode              String?
  mediaLastErrorAt                DateTime?
  mediaPolicy                     MediaPolicy                       @default(TURN_ONLY)
  sbcUdpExposureConfirmed         Boolean                           @default(false)
  sbcUdpExposureConfirmedAt       DateTime?
  sbcUdpExposureConfirmedByUserId String?
  /// Set when this tenant's PBX tenant was deleted on VitalPBX. The tenant is
  /// out of every list and cannot be billed from this moment; the permanent
  /// erase happens separately so a bad PBX response can never destroy data.
  pbxRemovedAt                    DateTime?
  /// Set instead of deleting when a removed tenant has completed payments —
  /// the books are kept, everything else is closed.
  archivedAt                      DateTime?
  createdAt                       DateTime                          @default(now())
  users                           User[]
  tenDlcSubs                      TenDlcSubmission[]
  campaigns                       SmsCampaign[]
  numbers                         PhoneNumber[]                     @relation("TenantOwnedNumbers")
  audits                          AuditLog[]
  providerCredentials             ProviderCredential[]
  billingSolaConfig               BillingSolaConfig?
  whatsappProviderConfigs         WhatsAppProviderConfig[]
