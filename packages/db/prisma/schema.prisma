model EmailJob {
  id               String         @id @default(cuid())
  tenantId         String
  invoiceId        String?
  type             String
  toEmail          String
  subject          String
  htmlBody         String
  textBody         String
  /// Files to send with this email: [{ filename, contentType, contentBase64 }].
  /// Bytes live here rather than on disk on purpose — see emailAttachments.ts.
  /// Capped at 5 files / 5 MB decoded, enforced when the job is created.
  attachments      Json           @default("[]")
