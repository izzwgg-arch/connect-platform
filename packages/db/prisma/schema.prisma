  pbxInstanceId String
  pbxTenantId   String?
  pbxTenantCode String?
  pbxDomain     String?
  status        PbxLinkStatus @default(LINKED)
  lastSyncAt    DateTime?
  lastError     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pbxInstance   PbxInstance   @relation(fields: [pbxInstanceId], references: [id], onDelete: Cascade)
}

model PbxExtensionLink {
  id                   String                    @id @default(cuid())
  tenantId             String
  extensionId          String                    @unique
  pbxExtensionId       String
  pbxSipUsername       String
  sipPasswordHash      String?
  sipPasswordIssuedAt  DateTime?
  /// AES-256-GCM encrypted SIP password (same envelope as apiAuthEncrypted). Set by admin via /pbx/extensions/:id/set-sip-password.
  sipPasswordEncrypted String?
  pbxDeviceId          String?
  /// VitalPBX device_name for the active (WebRTC-preferred) device, e.g. "T2_103_1". Displayed in admin UI for disambiguation.
  pbxDeviceName        String?
  /// True when this extension has a device with a WebRTC profile assigned in VitalPBX.
  webrtcEnabled        Boolean                   @default(false)
  isSuspended          Boolean                   @default(false)
  /// Connect-side provisioning state for the user's softphone (independent of desk-phone registrations).
  provisionStatus      ExtensionProvisionStatus  @default(PENDING)
  /// Where the current sipPasswordEncrypted came from. PBX_EXISTING = reused from sync, PBX_GENERATED = Wire reset, CONNECT_GENERATED = never used today.
  provisionSource      ExtensionProvisionSource?
  lastProvisionedAt    DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extension            Extension                 @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, extensionId])
  @@index([pbxExtensionId])
}

