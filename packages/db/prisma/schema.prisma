  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, dismissedAt, createdAt])
  @@index([tenantId, createdAt])
}

/// Super-admin visibility for voicemail ingestion stalls (REST vs spool, helper errors, notify/worker paths).
model VoicemailIngestIncident {
  id                   String    @id @default(cuid())
  fingerprint          String
  tenantId             String?
  scenario             String
  severity             String
  status               String
  firstSeenAt          DateTime  @default(now())
  lastSeenAt           DateTime  @updatedAt
  lastEventAt          DateTime?
  occurrenceCount      Int       @default(0)
  title                String
  actionText           String
  metadata             Json?
  resolvedAt           DateTime?
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  createdAt            DateTime  @default(now())
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([fingerprint, status])
  @@index([status, severity])
  @@index([tenantId])
  @@index([scenario, status])
  @@index([createdAt])
}

/// Platform admin alerts when WebRTC/SIP calling degrades (schema v2 black-box triggers).
model WebrtcCallingIncident {
  id              String                           @id @default(cuid())
  fingerprint     String
  tenantId        String
  failureType     String
  severity        String
  status          String                           @default("OPEN")
  direction       String
  firstSeenAt     DateTime                         @default(now())
  lastSeenAt      DateTime                         @updatedAt
  occurrenceCount Int                              @default(1)
  title           String
  actionText      String
  latestSipCode   Int?
  latestSipReason String?
  metadata        Json?
  resolvedAt      DateTime?
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  tenant          Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dismissals      WebrtcCallingIncidentDismissal[]

  @@index([fingerprint, status])
  @@index([tenantId, status])
  @@index([status, severity])
  @@index([lastSeenAt])
}

/// Per-admin dismiss — hides banner without deleting incident history.
model WebrtcCallingIncidentDismissal {
  id          String                @id @default(cuid())
  incidentId  String
  userId      String
  dismissedAt DateTime              @default(now())
  incident    WebrtcCallingIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([userId, dismissedAt])
}

/// Platform-wide WebRTC outage (cross-tenant) — GLOBAL_WEBRTC_OUTAGE.
model WebrtcPlatformOutage {
  id                      String                          @id @default(cuid())
  fingerprint             String
  failureType             String                          @default("GLOBAL_WEBRTC_OUTAGE")
  severity                String
  status                  String                          @default("OPEN")
  firstSeenAt             DateTime                        @default(now())
  lastSeenAt              DateTime                        @updatedAt
  occurrenceCount         Int                             @default(1)
  title                   String
  actionText              String
  diagnosisSummary        String?
  latestDiagnosisCategory String?
  latestSipCode           Int?
  latestSipReason         String?
  metadata                Json?
  resolvedAt              DateTime?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  dismissals              WebrtcPlatformOutageDismissal[]

  @@index([fingerprint, status])
  @@index([status, severity])
  @@index([lastSeenAt])
}

/// Per-admin dismiss for platform WebRTC outage banner.
model WebrtcPlatformOutageDismissal {
  id          String               @id @default(cuid())
  outageId    String
  userId      String
  dismissedAt DateTime             @default(now())
  outage      WebrtcPlatformOutage @relation(fields: [outageId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([outageId, userId])
  @@index([userId, dismissedAt])
}

model Extension {
  id                       String                   @id @default(cuid())
  tenantId                 String
  extNumber                String
  displayName              String
  pbxUserEmail             String?
  ownerUserId              String?
  status                   String                   @default("ACTIVE")
  billable                 Boolean                  @default(true)
  // Voicemail-to-email: when enabled, each NEW voicemail for this mailbox is
  // emailed to the extension's address (pbxUserEmail, else owner login email).
  // vmEmailIncludeTranscript controls whether the typed-out message is included.
  vmEmailEnabled           Boolean                  @default(true)
  vmEmailIncludeTranscript Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
