// ─── DID-level routing (shared-entry architecture) ───────────────────────────
// Connect-owned mapping for each inbound phone number: which tenant owns it,
// which IVR profile and MOH/hold profile are active, and which VitalPBX
// inbound-route (if any) was auto-provisioned by Connect via REST.
//
// When admins Publish a DidRouteMapping, Connect:
//   1. (optional, behind PBX_INBOUND_API flag) POSTs /api/v2/tenants/:vt/inbound_numbers
//      on VitalPBX to create/update the inbound route pointing at the shared
//      [connect-tenant-ivr] custom destination with TENANT_SLUG preset.
//   2. Writes AstDB keys via AMI DBPut:
//        connect/didmap/<e164>/tenant        = tenantSlug
//        connect/didmap/<e164>/profile_id    = ivrProfileId or ""
//        connect/didmap/<e164>/moh_class     = resolved MOH class name or ""
//        connect/didmap/<e164>/hold_announce = holdAnnounceRef or ""
//        connect/didmap/<e164>/hold_repeat   = holdRepeatSec or ""
//
// fallbackBehavior controls what the dialplan does if any mapping is missing:
//   "default_ivr"  — fall through to tenant's default business-hours IVR profile
//   "terminate"    — play safe fallback announcement and hang up
//   "voicemail"    — go to the tenant's default voicemail box if configured
model DidRouteMapping {
  id                          String    @id @default(cuid())
  tenantId                    String
  e164                        String // normalised E.164, e.g. "+18005551212"
  phoneNumberId               String? // FK → PhoneNumber (Connect-purchased); null for PBX-owned
  pbxInstanceId               String? // FK → PbxInstance (which PBX holds the inbound route)
  pbxInboundRouteId           String? // VitalPBX inbound route id once auto-created
  ivrProfileId                String? // FK → IvrRouteProfile (active IVR for this DID)
  mohProfileId                String? // FK → MohProfile (active Hold/MOH profile for this DID)
  holdAnnouncePromptRef       String? // VitalPBX recording ref for hold announcement
  holdRepeatSec               Int       @default(30) // seconds between announcement repeats
  fallbackBehavior            String    @default("default_ivr") // "default_ivr" | "terminate" | "voicemail"
  enabled                     Boolean   @default(true)
  lastPublishedAt             DateTime?
  // ── DID takeover (switch between PBX-native routing and Connect IVR) ──
  // `routingMode` tracks where the DID's inbound destination currently points:
  //   "pbx"     → VitalPBX still owns the routing (the factory/legacy destination)
  //   "connect" → Connect has repointed the inbound_number to [connect-tenant-ivr]
  // Before the first "switch to connect" we snapshot the live VitalPBX
  // inbound_number payload into the originalPbx* fields so a later "restore
  // to PBX" can PATCH it back verbatim without operator guesswork.
  routingMode                 String    @default("pbx") // "pbx" | "connect"
  originalPbxDestinationType  String? // e.g. "ivr", "queues", "extensions", "custom-destinations"
  originalPbxDestination      String? // opaque VitalPBX destination string (id or CEP)
  originalPbxChannelVariables Json? // full channel_variables map as last seen on PBX
  originalCapturedAt          DateTime? // when we captured the PBX-native destination
  lastSwitchedAt              DateTime? // last time routingMode flipped
  lastSwitchedBy              String? // user id that performed the flip
  lastSwitchError             String? // surfaced from last failed switch attempt (null on success)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  createdBy                   String?
  updatedBy                   String?

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ivrProfile  IvrRouteProfile?    @relation(fields: [ivrProfileId], references: [id], onDelete: SetNull)
  mohProfile  MohProfile?         @relation(fields: [mohProfileId], references: [id], onDelete: SetNull)
  pbxInstance PbxInstance?        @relation(fields: [pbxInstanceId], references: [id], onDelete: SetNull)
  switchLogs  DidRouteSwitchLog[]

  @@unique([e164])
  @@index([tenantId])
  @@index([tenantId, enabled])
  @@index([ivrProfileId])
  @@index([mohProfileId])
  @@index([pbxInstanceId])
  @@index([routingMode])
}

// ─── DID takeover audit log ──────────────────────────────────────────────────
// Every call to /voice/did/:id/switch-to-connect or /switch-to-pbx inserts one
// row so operators can see the full history of who repointed which DID and
// what the PBX state looked like before/after. Cheap to keep (one row per
// toggle) and indispensable for post-mortems when a tenant calls saying
// "my IVR stopped working".
// A booked hand-over of a phone number to a Connect menu — "switch this DID to
// the IVR at 9am Monday, and (optionally) hand it back on the 20th". Written by
// the IVR Studio at publish time; executed by the scheduler tick in server.ts,
// which drives the SAME switch-to-connect / switch-to-pbx routes an admin
// clicks, so a scheduled flip and a manual flip are literally one code path.
model DidSwitchSchedule {
  id           String    @id @default(cuid())
  tenantId     String
  mappingId    String // FK → DidRouteMapping
  ivrProfileId String // the menu the number should start ringing
  activateAt   DateTime // when the number switches to the menu
  endAt        DateTime? // null = keep it forever; else switch back to the PBX original
  // pending → activated → ended;  canceled and failed are terminal.
  status       String    @default("pending")
  lastError    String?
  createdBy    String?
  activatedAt  DateTime?
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, activateAt])
  @@index([status, endAt])
  @@index([tenantId])
  @@index([mappingId])
}

// A tenant-wide announcement played BEFORE the IVR greeting ("we're closed
// Thursday for the holiday"), bookable with a start and an optional stop.
// Runtime is one AstDB key (connect/t_<slug>/pre_announce) that the scheduler
// sets at startAt and clears at endAt — the dialplan plays it once per call,
// then falls into the normal menu.
model IvrAnnouncementSchedule {
  id        String    @id @default(cuid())
  tenantId  String
  promptRef String // e.g. "custom/holiday_notice"
  startAt   DateTime
  endAt     DateTime? // null = until someone turns it off
  // pending → active → ended;  canceled and failed are terminal.
  status    String    @default("pending")
  lastError String?
  createdBy String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, startAt])
  @@index([status, endAt])
  @@index([tenantId])
}

model DidRouteSwitchLog {
  id          String   @id @default(cuid())
  mappingId   String
  tenantId    String
  fromMode    String // "pbx" | "connect"
  toMode      String // "pbx" | "connect"
  performedBy String
  performedAt DateTime @default(now())
  pbxPayload  Json? // what we sent to VitalPBX (null on pure DB updates)
  pbxSnapshot Json? // what we read from VitalPBX before the change
  status      String // "pending" | "success" | "failed"
  error       String? // stringified failure reason when status="failed"

  mapping DidRouteMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@index([mappingId])
  @@index([tenantId, performedAt])
  @@index([status])
}

// ─── MOH uploaded media assets ───────────────────────────────────────────────
// Metadata catalog of tenant-owned music files uploaded to Connect. The actual
// audio bytes live in object storage (S3/R2) at `storageKey`; they are pulled
// by the PBX-host `connect-media-sync` helper on a cron, which drops them into
// /var/lib/asterisk/moh/<mohClassName>/ and runs `asterisk -rx "moh reload"`.
//
// mohClassName is deterministic per tenant+name: "connect_<tenantSlug>_<slug(name)>".
// status flow: uploading -> ready -> (optionally) failed | archived
/// Read-only index of Music-On-Hold classes that already exist on the VitalPBX
/// side (table `ombutel.ombu_music_groups`). Populated by the super-admin
/// "Auto-Sync PBX MOH classes" action which runs the same bounded, indexed
/// MariaDB query pattern as the prompt and DID syncs — no filesystem scan, no
/// call-time traffic, no polling. Admins pick from this catalog when they
/// want a Hold Profile to point at a class VitalPBX already knows about.
///
/// Tenant mapping reuses TenantPbxLink (numeric VitalPBX tenant_id → Connect
/// tenantId). A class whose tenant cannot be resolved is stored with
/// `tenantId = null` so super-admins can still see + re-home it manually.
model PbxMohClass {
  id              String   @id @default(cuid())
  pbxInstanceId   String // which PBX this class lives on
  tenantId        String? // Connect tenant (nullable when mapping unknown)
  tenantSlug      String?
  pbxGroupId      Int // ombu_music_groups.music_group_id
  pbxTenantId     String? // raw VitalPBX numeric tenant_id, as string
  name            String // raw name column (e.g. "default", "main")
  mohClassName    String // name as Asterisk/VitalPBX exposes it — typically equals `name`
  classType       String? // "files" | "stream" | "custom" etc.
  streamingUrl    String?
  streamingFormat String?
  isDefault       Boolean  @default(false)
  fileCount       Int      @default(0) // rolled up from ombu_music_files
  isActive        Boolean  @default(true) // false = removed in VitalPBX on last sync
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Catalog / playability columns (migration 20260701160000) — existed in the
  /// DB but were missing from this model until 2026-07-26 (schema drift).
  origin            String? // MohClassOrigin: "tenant" | "main" | "global_default" | "connect_upload" | "unassigned"
  loadedInAsterisk  Boolean? // live `moh show classes` probe; null = unknown
  selectable        Boolean   @default(true)
  unavailableReason String? // "deactivated" | "not_loaded" | "no_files"
  lastProbedAt      DateTime?

  pbxInstance PbxInstance @relation(fields: [pbxInstanceId], references: [id], onDelete: Cascade)
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([pbxInstanceId, pbxGroupId])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([pbxInstanceId, isActive])
  @@index([pbxInstanceId, selectable])
}

model MohAsset {
  id                 String   @id @default(cuid())
  tenantId           String
  tenantSlug         String // denormalised for helper lookups
  name               String // human label, e.g. "Holiday Jazz Mix"
  mohClassName       String // deterministic, e.g. "connect_acme_holiday_jazz"
  sourceFilename     String // original upload filename
  /// Legacy single-key field; new rows mirror PBX artifact key when ready.
  storageKey         String
  originalStorageKey String? // raw upload bytes (preview / history)
  pbxStorageKey      String? // 8 kHz mono 16-bit PCM WAV for Asterisk sync only
  contentHash        String // sha256 hex of PBX artifact when ready (manifest diff)
  sizeBytes          Int // PBX artifact size when ready; otherwise original upload size
  durationSec        Int? // from ffprobe, null until validated
  mimeType           String // legacy; prefer originalMimeType for new rows
  originalMimeType   String?
  pbxFormat          String? // e.g. wav_pcm_s16le_8k_mono
  conversionStatus   String   @default("pending") // pending | ready | failed
  conversionError    String?
  status             String   @default("uploading") // "uploading" | "ready" | "failed" | "archived"
  failureReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, mohClassName])
  @@index([contentHash])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
}

// ── Connect unified chat (internal + VoIP.ms SMS) ───────────────────────────

enum ConnectChatThreadType {
  SMS
  DM
  GROUP
  TENANT_GROUP
  WHATSAPP
}

enum ConnectChatMessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ConnectChatMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE_NOTE
  FILE
  LOCATION
  SYSTEM
}

enum ConnectChatParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

/// Singleton-style row (id = "default") for platform VoIP.ms API credentials.
/// Platform-wide Cardknox/SOLA gateway defaults (iFields public key, etc).
/// Set once; applies to all tenants that have no per-tenant override.
model GlobalSolaConfig {
  id         String   @id @default("default")
  /// Cardknox iFields public key — used by the hosted card-capture form on all tenant billing pages.
  ifieldsKey String?
  updatedAt  DateTime @updatedAt
  updatedBy  String?
}

model GlobalVoipMsConfig {
  id                     String    @id @default("default")
  credentialsEncrypted   String?
  credentialsKeyId       String    @default("v1")
  apiBaseUrl             String?
  smsEnabled             Boolean   @default(false)
  mmsEnabled             Boolean   @default(false)
  webhookSecretEncrypted String?
  lastDidsSyncAt         DateTime?
  lastHealthAt           DateTime?
  lastHealthOk           Boolean?
  lastHealthMessage      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

/// VoIP.ms SMS-capable number assigned to a tenant (optionally to one user/extension or a specific set of users).
model TenantSmsNumber {
  id                  String                @id @default(cuid())
  /// Null until assigned to a Connect tenant (synced inventory row).
  tenantId            String?
  provider            IntegrationProvider   @default(VOIPMS)
  voipmsDid           String?
  phoneRaw            String?
  phoneE164           String                @unique
  smsCapable          Boolean               @default(true)
  mmsCapable          Boolean               @default(false)
  assignedUserId      String?
  assignedExtensionId String?
  isTenantDefault     Boolean               @default(false)
  active              Boolean               @default(true)
  lastSyncedAt        DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser        User?                 @relation("TenantSmsNumberAssignUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedExtension   Extension?            @relation("TenantSmsNumberAssignExtension", fields: [assignedExtensionId], references: [id], onDelete: SetNull)
  /// Explicit multi-user assignments (mutually exclusive with assignedExtensionId).
  assignedUsers       TenantSmsNumberUser[]

  @@index([tenantId, active])
  @@index([tenantId, isTenantDefault])
}

/// Join table: a specific set of users explicitly assigned to a VoIP.ms SMS number.
/// When entries exist, inbound threads fan out only to these users (not the whole tenant).
model TenantSmsNumberUser {
  id                String          @id @default(cuid())
  tenantSmsNumberId String
  userId            String
  /// SHARED = one shared thread for this DID; PERSONAL = this user gets their own scoped thread using the same DID.
  inboxMode         String          @default("SHARED") @db.VarChar(16)
  createdAt         DateTime        @default(now())
  tenantSmsNumber   TenantSmsNumber @relation(fields: [tenantSmsNumberId], references: [id], onDelete: Cascade)
  user              User            @relation("TenantSmsNumberMultiUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantSmsNumberId, userId])
  @@index([tenantSmsNumberId])
  @@index([tenantSmsNumberId, inboxMode])
  @@index([userId])
}

model ConnectChatThread {
  id                   String                   @id @default(cuid())
  tenantId             String
  type                 ConnectChatThreadType
  title                String?
  createdByUserId      String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  lastMessageAt        DateTime                 @default(now())
  isDefaultTenantGroup Boolean                  @default(false)
  active               Boolean                  @default(true)
  /// Stable key: SMS `sms:{tenant}:{tenantE164}:{externalE164}:{inboxScope}` — DM/group unique id
  dedupeKey            String                   @unique
  tenantSmsRaw         String?
  tenantSmsE164        String?
  externalSmsRaw       String?
  externalSmsE164      String?
  /// "" = tenant-wide SMS inbox; else Connect user id for assigned-number personal inbox
  smsInboxOwnerUserId  String                   @default("")
  markedUnreadAt       DateTime?
  markedUnreadById     String?
  participants         ConnectChatParticipant[]
  messages             ConnectChatMessage[]
  // ⛔ The ONLY tenant relation in this schema without onDelete, so it defaulted
  // to Restrict — one chat thread was enough to make deleting a tenant fail with
  // a foreign-key error. Every other tenant relation (240 of them) cascades.
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, lastMessageAt])
  @@index([tenantId, type])
  @@index([tenantSmsE164, externalSmsE164])
}

model ConnectChatParticipant {
  id              String                     @id @default(cuid())
  threadId        String
  participantKey  String
  userId          String?
  extensionId     String?
  role            ConnectChatParticipantRole @default(MEMBER)
  joinedAt        DateTime                   @default(now())
  leftAt          DateTime?
  lastReadAt      DateTime?
  typingUntil     DateTime?
  muted           Boolean                    @default(false)
  archivedForUser Boolean                    @default(false)
  thread          ConnectChatThread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user            User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  extension       Extension?                 @relation("ConnectChatParticipantExtension", fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([threadId, participantKey])
  @@index([userId])
}

model ConnectChatMessage {
  id                     String                         @id @default(cuid())
  tenantId               String
  threadId               String
  /// Nullable AND set to NULL automatically (see senderUser onDelete: SetNull below) whenever the
  /// sending staff account is deleted — a normal, recurring event (offboarding), not a data bug.
  /// NEVER use `senderUserId === viewer` to decide "mine" for SMS threads; it will silently break
  /// again every time a rep who sent messages is removed. Use `isConnectChatMessageMine()` from
  /// apps/api/src/connectChatMessageMine.ts, which keys SMS off `direction` instead.
  senderUserId           String?
  senderExtensionId      String?
  direction              ConnectChatMessageDirection
  type                   ConnectChatMessageType         @default(TEXT)
  body                   String                         @default("")
  metadata               Json?
  replyToMessageId       String?
  editedAt               DateTime?
  deletedForEveryoneAt   DateTime?
  deletedForUserIds      Json?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  smsProviderMessageId   String?
  deliveryStatus         String?
  deliveryError          String?
  externalProvider       String?
  externalMessageId      String?
  externalConversationId String?
  providerStatus         String?
  providerMetadata       Json?
  /// SMS-to-Email: stamped once after an inbound text is emailed to opted-in users
  /// (so it is never emailed twice). emailForwardError holds the skip/fail reason.
  emailForwardedAt       DateTime?
  emailForwardError      String?
  deliveredAt            DateTime?
  thread                 ConnectChatThread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUser             User?                          @relation("ConnectChatMessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)
  replyTo                ConnectChatMessage?            @relation("ConnectChatMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies                ConnectChatMessage[]           @relation("ConnectChatMessageReply")
  attachments            ConnectChatMessageAttachment[]
  reactions              ConnectChatMessageReaction[]
  whatsAppUsageEvents    WhatsAppUsageEvent[]

  @@index([threadId, createdAt])
  @@index([tenantId, createdAt])
  @@index([createdAt]) // notification reconciler: global recent-inbound sweep
  @@index([smsProviderMessageId])
  @@index([tenantId, externalProvider, externalMessageId])
  @@index([tenantId, externalConversationId])
}

model ConnectChatMessageAttachment {
  id          String             @id @default(cuid())
  messageId   String
  tenantId    String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String
  contentHash String?
  scanStatus  String             @default("pending")
  // Cached classifier ("image" | "audio" | "video" | "file") so the chat UI
  // can pick a bubble renderer without re-parsing the MIME on every render.
  mediaKind   String             @default("file")
  // Audio + video duration captured at upload time (ffprobe); null for images
  // and any media we couldn't probe.
  durationMs  Int?
  // Image + video pixel dimensions captured at upload time; null otherwise.
  width       Int?
  height      Int?
  createdAt   DateTime           @default(now())
  message     ConnectChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([messageId])
}

model ConnectChatMessageReaction {
  id        String             @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  message   ConnectChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model SmsRoutingLog {
  id                  String   @id @default(cuid())
  rawFrom             String?
  rawTo               String?
  normalizedFrom      String?
  normalizedTo        String?
  direction           String
  resolvedTenantId    String?
  resolvedUserId      String?
  resolvedExtensionId String?
  resolvedThreadId    String?
  status              String
  error               String?
  payload             Json?
  createdAt           DateTime @default(now())
  tenant              Tenant?  @relation(fields: [resolvedTenantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([normalizedTo, createdAt])
}

/// Singleton row `id = "default"`. JSON shape: { "END_USER"?: string[], "TENANT_ADMIN"?: string[], "SUPER_ADMIN"?: string[] } (portal permission keys).
model PlatformRolePermissionSnapshot {
  id        String   @id @default("default")
  roles     Json
  updatedAt DateTime @updatedAt
}

// ─── CRM Foundation ───────────────────────────────────────────────────────────

enum CrmUserRole {
  AGENT
  MANAGER
  ADMIN
}

/// Per-tenant CRM feature flags. Created on-demand when a tenant admin enables CRM.
/// Absence of a row = CRM disabled. enabled=false also disables all CRM API routes for the tenant.
model CrmTenantSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  enabled              Boolean  @default(false)
  localPresenceEnabled Boolean  @default(false)
  transcriptionEnabled Boolean  @default(false)
  /// Default sort for the agent queue. One of: SMART | ORIGINAL. Applied when the
  /// agent has no localStorage preference and the URL has no explicit ?sort= param.
  defaultQueueSort     String   @default("SMART")
  /// Default filter tab for the agent queue. One of: PENDING | DUE | OVERDUE | UPCOMING.
  defaultQueueFilter   String   @default("PENDING")
  /// Tenant-defined quick disposition buttons (JSON array). Built-in defaults are merged in API.
  quickDispositions    Json?
  /// Tenant default CRM workspace script. Null means agents choose manually.
  defaultScriptId      String?
  /// Tenant default CRM workspace checklist. Null means agents choose manually.
  defaultChecklistId   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Per-user CRM access grant. Only users with enabled=true can access CRM agent features.
/// Absence of a row = no CRM access for that user (even if CrmTenantSettings.enabled=true).
/// Tenant admins and super admins bypass this check for management routes.
model CrmUserAccess {
  id        String      @id @default(cuid())
  tenantId  String
  userId    String
  enabled   Boolean     @default(true)
  role      CrmUserRole @default(AGENT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, enabled])
}

/// Per-user CRM campaign access. When rows exist for a user, non-admin CRM users
/// only see/work campaigns in this set. Absence of rows = unrestricted (all tenant campaigns).
model CrmUserCampaignAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  campaignId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign CrmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, campaignId])
  @@index([tenantId, userId])
  @@index([tenantId, campaignId])
}

// ─── CRM Contacts ─────────────────────────────────────────────────────────────

enum CrmContactStage {
  LEAD
  CONTACTED
  QUALIFIED
  CUSTOMER
  CLOSED_LOST
}

enum CrmLeadTimezoneResolutionStatus {
  RESOLVED
  NEEDS_REVIEW
  MISSING_LOCATION
}

/// CRM metadata overlay on top of an existing Contact record.
/// A Contact becomes a CRM contact when this row is created.
/// Deleting the Contact cascades and removes the CRM meta.
/// No contact data is duplicated — all phones/emails/names live on Contact.
model CrmContactMeta {
  id                       String                           @id @default(cuid())
  contactId                String                           @unique
  tenantId                 String
  stage                    CrmContactStage                  @default(LEAD)
  assignedToUserId         String?
  doNotCall                Boolean                          @default(false)
  doNotSms                 Boolean                          @default(false)
  externalId               String?
  ssn                      String?
  monthlyRevenue           String?
  lastActivityAt           DateTime?
  lastDisposition          String?
  lastDispositionAt        DateTime?
  timezoneIana             String?
  timezoneLabel            String?
  timezoneOffsetMinutes    Int?
  timezoneResolvedAt       DateTime?
  timezoneResolutionStatus CrmLeadTimezoneResolutionStatus?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTo User?   @relation("CrmContactAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, stage])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, createdAt])
  @@index([tenantId, lastActivityAt])
  @@index([tenantId, timezoneLabel])
  @@index([tenantId, timezoneIana])
  @@index([tenantId, timezoneResolutionStatus])
}

enum CrmDispositionChannel {
  CALL
  SMS
  EMAIL
  VOICEMAIL_DROP
}

/// Per-phone (and channel) disposition history for CRM outreach.
/// Latest row per phoneId drives contact phone summary; contact-level lastDisposition
/// on CrmContactMeta remains the most recent disposition across all phones.
model CrmContactPhoneDisposition {
  id              String                @id @default(cuid())
  tenantId        String
  contactId       String
  phoneId         String?
  channel         CrmDispositionChannel
  disposition     String
  note            String?
  createdByUserId String
  createdAt       DateTime              @default(now())

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phone     ContactPhone? @relation(fields: [phoneId], references: [id], onDelete: SetNull)
  createdBy User          @relation("CrmPhoneDispositionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, contactId, phoneId, createdAt])
  @@index([tenantId, contactId, createdAt])
}

// ─── CRM Timeline & Notes ─────────────────────────────────────────────────────

enum CrmCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CrmCampaignPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CrmCampaignMemberStatus {
  PENDING
  IN_PROGRESS
  CONTACTED
  CALLBACK
  CONVERTED
  SKIPPED
  DO_NOT_CALL
}

enum CrmTimelineEventType {
  CONTACT_CREATED
  STAGE_CHANGED
  NOTE_ADDED
  NOTE_EDITED
  TASK_CREATED
  TASK_COMPLETED
  TASK_CANCELED
  CDR_INBOUND
  CDR_OUTBOUND
  CHECKLIST_COMPLETED
  DISPOSITION_SET
  CONTACT_MERGED
  ASSIGNED_TO_USER
  SMS_SENT
  SMS_RECEIVED
  EMAIL_SENT
  EMAIL_RECEIVED
  EMAIL_REPLY
  WEBSITE_SUBMISSION
  VOICEMAIL_DROP
  FORM_SENT
  FORM_OPENED
  FORM_COMPLETED
  FORM_REVOKED
}

enum CrmCallTranscriptStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  UNAVAILABLE
}

/// Immutable audit-style record of CRM activity for a contact.
/// body stores human-readable content (note text, stage description).
/// metadata stores machine-readable detail (e.g. { from, to } for stage changes).
/// linkedId references an external row (e.g. CrmContactNote.id, ConnectCdr.id).
/// Do NOT delete timeline events; they are an append-only log.
model CrmTimelineEvent {
  id              String               @id @default(cuid())
  tenantId        String
  contactId       String
  type            CrmTimelineEventType
  title           String
  body            String?
  metadata        Json?
  linkedId        String?
  createdByUserId String?
  createdAt       DateTime             @default(now())

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("CrmTimelineEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([contactId, createdAt])
  @@index([contactId, linkedId]) // fast dedup lookup for CDR hook
}

/// Post-call transcript/summary for a CRM call recording.
/// One row per tenant + CDR linkedId; raw PBX recording paths are never stored here.
model CrmCallTranscript {
  id                  String                  @id @default(cuid())
  tenantId            String
  contactId           String
  linkedId            String
  status              CrmCallTranscriptStatus @default(QUEUED)
  provider            String                  @default("google")
  languageCode        String                  @default("en-US")
  transcript          String?                 @db.Text
  summary             String?                 @db.Text
  actionItems         Json?
  sentiment           String?
  intent              String?
  confidence          Float?
  modelName           String?
  googleOperationName String?
  gcsUri              String?
  audioDurationSec    Int?
  errorCode           String?
  errorMessage        String?
  queuedAt            DateTime                @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, linkedId])
  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, status, updatedAt])
  @@index([contactId, linkedId])
}

/// Structured notes on a CRM contact. Multiple notes per contact; each has an author.
/// When a note is created, a CrmTimelineEvent(NOTE_ADDED) is also written.
/// When edited, both the note body and the linked timeline event body are updated.
model CrmContactNote {
  id              String   @id @default(cuid())
  tenantId        String
  contactId       String
  body            String
  pinned          Boolean  @default(false)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("CrmContactNoteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, contactId, createdAt])
  @@index([contactId, createdAt])
}

// ─── CRM Tasks ────────────────────────────────────────────────────────────────

enum CrmTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CrmTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

/// A follow-up task or action item linked to a CRM contact.
/// Timeline events are written for creation, completion, and cancellation.
/// Minor edits (title, body, dueAt, priority) do NOT write timeline events.
model CrmContactTask {
  id                String          @id @default(cuid())
  tenantId          String
  contactId         String
  title             String
  body              String?
  dueAt             DateTime?
  assignedToUserId  String?
  priority          CrmTaskPriority @default(MEDIUM)
  status            CrmTaskStatus   @default(OPEN)
  completedAt       DateTime?
  completedByUserId String?
  createdByUserId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo  User?   @relation("CrmTaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  completedBy User?   @relation("CrmTaskCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  createdBy   User    @relation("CrmTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, contactId, status, dueAt])
  @@index([tenantId, assignedToUserId, status, dueAt])
  @@index([tenantId, status, dueAt])
}

// ─── CRM Import ───────────────────────────────────────────────────────────────

enum CrmImportBatchStatus {
  PENDING
  PROCESSING
  DONE
  PARTIAL
  FAILED
}

/// Tracks a single CSV import run. Rows are processed synchronously for MVP.
/// errors Json stores per-row error details: [{ row: number, reason: string }]
/// mapping Json stores the auto-detected column mapping: { csvHeader: fieldKey }
/// auditErrorCount: how many CrmImportBatchRow writes failed during the import run.
/// Non-zero means Drive matching may be incomplete for this batch.
model CrmImportBatch {
  id              String               @id @default(cuid())
  tenantId        String
  fileName        String
  status          CrmImportBatchStatus @default(PENDING)
  totalRows       Int                  @default(0)
  processedRows   Int                  @default(0)
  createdCount    Int                  @default(0)
  updatedCount    Int                  @default(0)
  skippedCount    Int                  @default(0)
  errorCount      Int                  @default(0)
  /// Count of CrmImportBatchRow writes that failed. Non-zero = Drive match may be incomplete.
  auditErrorCount Int                  @default(0)
  errors          Json                 @default("[]")
  mapping         Json?
  createdByUserId String
  createdAt       DateTime             @default(now())
  completedAt     DateTime?

  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User                        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  batchRows     CrmImportBatchRow[]
  leadDocuments CrmLeadDocument[]
  pipelineRuns  CrmImportBatchPipelineRun[]

  @@index([tenantId, createdAt])
}

/// Per-row audit record for a CRM import batch.
/// Captures the company name and resolved contactId for each row so the Drive
/// match engine can map normalised company names → contacts.
model CrmImportBatchRow {
  id                    String  @id @default(cuid())
  tenantId              String
  batchId               String
  rowNumber             Int
  contactId             String?
  companyName           String?
  companyNameNormalized String?
  action                String

  createdAt DateTime @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch   CrmImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  contact Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([tenantId, contactId])
  @@index([tenantId, companyNameNormalized])
}

/// Call script — plain-text body shown in the Live Call Workspace.
/// Agents select a script before or during a call. Not linked to a contact directly.
model CrmScript {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  body            String   @db.Text
  isActive        Boolean  @default(true)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User          @relation("CrmScriptCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  campaigns CrmCampaign[]

  @@index([tenantId, isActive, createdAt])
}

enum CrmVoicemailDropStatus {
  READY
  PROCESSING
  FAILED
  ARCHIVED
}

/// Tenant-scoped pre-recorded voicemail audio that agents can drop into an active outbound call.
model CrmVoicemailDrop {
  id                 String                 @id @default(cuid())
  tenantId           String
  createdByUserId    String
  name               String
  description        String?
  campaignId         String?
  isDefault          Boolean                @default(false)
  status             CrmVoicemailDropStatus @default(PROCESSING)
  durationSeconds    Int?
  originalFileName   String?
  originalMimeType   String?
  originalStorageKey String?
  pbxStorageKey      String?
  pbxFileBaseName    String?
  pbxFormat          String?
  contentHash        String?
  sizeBytes          Int?
  conversionStatus   String                 @default("pending")
  conversionError    String?
  usageCount         Int                    @default(0)
  lastUsedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User         @relation("CrmVoicemailDropCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  campaign  CrmCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, isDefault])
  @@index([tenantId, campaignId])
  @@index([tenantId, createdAt])
}

/// Call checklist template — a named list of required/optional items.
/// Agents fill in a CrmChecklistResponse per call/contact.
model CrmChecklist {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  isActive        Boolean  @default(true)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User                   @relation("CrmChecklistCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items     CrmChecklistItem[]
  responses CrmChecklistResponse[]
  campaigns CrmCampaign[]

  @@index([tenantId, isActive, createdAt])
}

/// Individual item inside a CrmChecklist template.
model CrmChecklistItem {
  id          String  @id @default(cuid())
  checklistId String
  label       String
  required    Boolean @default(false)
  sortOrder   Int     @default(0)

  checklist CrmChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, sortOrder])
}

/// A saved agent response to a checklist during a call.
/// answers is a JSON map of { [itemId]: boolean }.
/// CHECKLIST_COMPLETED timeline event is written when this is created.
model CrmChecklistResponse {
  id                String   @id @default(cuid())
  tenantId          String
  checklistId       String
  contactId         String
  linkedId          String? // CDR linkedId if call is known; null if saved offline
  completedByUserId String
  answers           Json // { [itemId]: boolean }
  createdAt         DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checklist   CrmChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  completedBy User         @relation("CrmChecklistResponseCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, contactId, createdAt])
  @@index([contactId, createdAt])
}

// ─── CRM Campaigns ────────────────────────────────────────────────────────────

/// A named outbound calling campaign. Members are contacts enrolled in the campaign.
/// Optionally linked to a CrmScript and/or CrmChecklist for agent use.
model CrmCampaign {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  status          CrmCampaignStatus   @default(DRAFT)
  priority        CrmCampaignPriority @default(NORMAL)
  scriptId        String?
  checklistId     String?
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy      User                        @relation("CrmCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  script         CrmScript?                  @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  checklist      CrmChecklist?               @relation(fields: [checklistId], references: [id], onDelete: SetNull)
  voicemailDrops CrmVoicemailDrop[]
  members        CrmCampaignMember[]
  userAccess     CrmUserCampaignAssignment[]

  @@index([tenantId, status, createdAt])
}

/// A single contact enrolled in a CrmCampaign — the primary queue row.
/// One contact can appear in multiple campaigns, but only once per campaign (@@unique).
/// attemptCount tracks how many call outcomes have been saved for this member.
model CrmCampaignMember {
  id               String                  @id @default(cuid())
  tenantId         String
  campaignId       String
  contactId        String
  assignedToUserId String?
  status           CrmCampaignMemberStatus @default(PENDING)
  attemptCount     Int                     @default(0)
  lastAttemptAt    DateTime?
  sortOrder        Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   CrmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?       @relation("CrmCampaignMemberAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  callbackAt   DateTime?
  callbackNote String?

  @@unique([campaignId, contactId])
  @@index([tenantId, campaignId, status, sortOrder])
  @@index([tenantId, assignedToUserId, status])
  @@index([tenantId, assignedToUserId, status, callbackAt])
}

// Add back-relations to CrmScript and CrmChecklist so campaigns can link to them
// (required by Prisma for optional FK relations pointing back)
// These are added inline here to avoid schema-order dependency issues.

/// Phase 4B — CRM Local Presence Caller ID Pool.
/// Associates tenant-owned PhoneNumber DIDs with 3-digit US area codes so that
/// selectCrmCallerId() can pick the best outbound caller ID for a destination.
/// Only PhoneNumber rows belonging to the same tenant may be added.
/// The actual call is still placed client-side via SIP/WebRTC; this is advisory only.
model CrmCallerIdPool {
  id            String   @id @default(cuid())
  tenantId      String
  phoneNumberId String
  areaCode3     String   @db.VarChar(3) /// 3-digit US area code, e.g. "512"
  label         String? /// Optional human label for the pool entry
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation("TenantCrmCallerIdPool", fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumber PhoneNumber @relation("PhoneNumberCrmCallerIdPool", fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneNumberId])
  @@index([tenantId, areaCode3, isActive])
  @@index([tenantId, isActive])
}

/// Tenant-scoped custom role. Permissions are additive on top of the built-in role bucket.
/// permissions is a JSON array of PortalPermissionKey strings.
model CustomRole {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  active          Boolean  @default(true)
  permissions     Json     @default("[]")
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("CustomRoleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("CustomRoleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  userAssignments UserCustomRole[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

/// Assignment of a CustomRole to a User within a tenant.
model UserCustomRole {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String
  customRoleId     String
  assignedByUserId String?
  createdAt        DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole CustomRole @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  assignedBy User?      @relation("UserCustomRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, customRoleId])
  @@index([tenantId, userId])
  @@index([tenantId, customRoleId])
}

enum OnboardingStatus {
  INVITE_SENT
  IN_PROGRESS
  SUBMITTED
  AWAITING_PBX_SETUP
  AWAITING_PORT
  AWAITING_PAYMENT
  READY_TO_SYNC
  ACTIVE
  COMPLETED
  CANCELED
}

enum OnboardingEventType {
  CREATED
  AUTOSAVED
  FILE_UPLOADED
  STATUS_CHANGED
  CHECKLIST_UPDATED
  NOTES_UPDATED
  SUBMITTED
}

model OnboardingSubmission {
  id                    String           @id @default(cuid())
  publicToken           String?          @unique
  companyName           String?
  contactFirstName      String?
  contactLastName       String?
  mainEmail             String?
  billingEmail          String?
  mainPhone             String?
  phoneNumberChoice     String?
  smsEnabled            Boolean          @default(false)
  smsMonthlyPriceCents  Int              @default(0)
  status                OnboardingStatus @default(INVITE_SENT)
  currentStep           String?
  answers               Json?
  provisioningChecklist Json?
  internalNotes         Json?
  cardTokenPreview      String?
  createdTenantId       String?
  /// Sign-up payment. Nothing is purchased on a customer's behalf until paidAt
  /// is set — see apps/api/src/onboarding/onboardingPayment.ts.
  paidAt                DateTime?
  paidInvoiceId         String?
  paidAmountCents       Int?
  submittedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // ── Automated provisioning state ──────────────────────────────────────────
  // VoIP.ms number stage (runs in the background right after the number step):
  //   pending → provisioning → ready | failed
  numberStatus              String?
  provisionedDid            String? // 10-digit DID actually live on the subaccount
  didIsTemporary            Boolean @default(false) // true while a port is pending
  voipmsSubaccountEncrypted String? // encrypted { username, password, server }
  // VitalPBX build stage (runs after final submit):
  //   queued → building → syncing → inviting → done | failed
  pbxSetupStatus            String?
  pbxTenantPath             String? // VitalPBX tenant path hash once created
  setupError                String?

  requestedExtensions OnboardingRequestedExtension[]
  uploadedFiles       OnboardingUploadedFile[]
  events              OnboardingEvent[]
}

model OnboardingRequestedExtension {
  id           String   @id @default(cuid())
  submissionId String
  displayName  String?
  extNumber    String
  email        String?
  vmPassword   String?
  smsEnabled   Boolean  @default(false)
  // Cell-phone forwarding chosen in the wizard ("virtual device" on the PBX):
  //   cellMode: null | "also" (extension + cell ring together) | "only" (straight to cell)
  cellMode     String?
  cellNumber   String?
  createdAt    DateTime @default(now())

  submission OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model OnboardingUploadedFile {
  id           String   @id @default(cuid())
  submissionId String
  filename     String
  mimeType     String?
  sizeBytes    Int
  storageKey   String
  kind         String
  createdAt    DateTime @default(now())

  submission OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model OnboardingEvent {
  id           String              @id @default(cuid())
  submissionId String
  type         OnboardingEventType
  message      String?
  createdAt    DateTime            @default(now())

  submission OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
}

// ─── CRM Funders ─────────────────────────────────────────────────────────────
// Separate entity workspace for funding/referral/insurance/provider records.
// Deliberately NOT reusing Contact to avoid cross-contamination of CRM contact
// workflows, tags, and CDR screen-pop. Funders have their own tag namespace.

enum FunderStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  PENDING
}

model Funder {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  organization String?
  email        String?
  phone        String?
  phone2       String?
  city         String?
  state        String?
  zip          String?
  notes        String?
  status       FunderStatus @default(ACTIVE)
  active       Boolean      @default(true)
  archivedAt   DateTime?
  createdBy    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator        User?                 @relation("FunderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  tagLinks       FunderTagAssignment[]
  timelineEvents FunderTimelineEvent[]

  @@index([tenantId, active])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, name])
}

model FunderTimelineEvent {
  id              String   @id @default(cuid())
  tenantId        String
  funderId        String
  type            String
  title           String
  body            String?
  metadata        Json?
  linkedId        String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  funder        Funder @relation(fields: [funderId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("FunderTimelineEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, funderId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([funderId, linkedId])
}

model FunderTag {
  id          String                @id @default(cuid())
  tenantId    String
  name        String
  color       String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments FunderTagAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model FunderTagAssignment {
  funderId String
  tagId    String
  funder   Funder    @relation(fields: [funderId], references: [id], onDelete: Cascade)
  tag      FunderTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([funderId, tagId])
  @@index([tagId])
}

model FunderImportBatch {
  id           String   @id @default(cuid())
  tenantId     String
  fileName     String
  status       String   @default("PENDING")
  totalRows    Int      @default(0)
  createdCount Int      @default(0)
  updatedCount Int      @default(0)
  skippedCount Int      @default(0)
  errorCount   Int      @default(0)
  errors       Json     @default("[]")
  mapping      Json     @default("{}")
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Bulk email job — tenant-scoped, server-side queued send to many recipients.
/// sourceType: CONTACTS | CAMPAIGN | FUNDERS
/// status: QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
model CrmBulkEmailJob {
  id              String    @id @default(cuid())
  tenantId        String
  createdByUserId String?
  /// CONTACTS | CAMPAIGN | FUNDERS
  sourceType      String
  /// Optional: campaign members source
  campaignId      String?
  /// Optional: tag filter (ContactTag.id or FunderTag.id depending on sourceType)
  tagId           String?
  /// Optional: explicit list of contact IDs or funder IDs. Null = all filtered results.
  contactIds      Json?
  /// Required: email template to render and send
  templateId      String
  /// Optional: resolved CrmEmailConnection to send from. Null = deferred to worker.
  connectionId    String?
  /// QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  status          String    @default("QUEUED")
  totalCount      Int       @default(0)
  queuedCount     Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  skippedCount    Int       @default(0)
  errorSummary    String?
  scheduledAt     DateTime?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?                   @relation("CrmBulkEmailJobCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  template   CrmEmailTemplate        @relation(fields: [templateId], references: [id])
  connection CrmEmailConnection?     @relation(fields: [connectionId], references: [id])
  recipients CrmBulkEmailRecipient[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

/// Per-recipient row for a CrmBulkEmailJob. One row per intended email send.
/// status: QUEUED | SENT | FAILED | SKIPPED
model CrmBulkEmailRecipient {
  id             String    @id @default(cuid())
  jobId          String
  tenantId       String
  /// FK to Contact (for CONTACTS / CAMPAIGN source)
  contactId      String?
  /// FK to Funder (for FUNDERS source)
  funderId       String?
  /// Resolved email address at job creation time
  toEmail        String
  /// QUEUED | SENT | FAILED | SKIPPED
  status         String    @default("QUEUED")
  /// MISSING_EMAIL | DUPLICATE | OTHER
  skipReason     String?
  /// Prevents duplicate sends if worker restarts
  idempotencyKey String    @unique
  gmailMessageId String?
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  job CrmBulkEmailJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([tenantId, jobId])
}

// ─── CRM Drive Foundation (Phase 1) ─────────────────────────────────────────
// Google Drive integration — folder selection + lead document model foundation.
// Phase 1: auth, folder config, file listing, metadata only.
// Phase 2+: OCR, AI summaries, download, auto-matching (NOT in this phase).

enum CrmDriveFolderPurpose {
  LEAD_IMPORT_INBOX
}

enum CrmLeadDocumentSource {
  GOOGLE_DRIVE
  MANUAL_UPLOAD
  EMAIL_ATTACHMENT
}

enum CrmLeadDocumentStatus {
  /// Match found but not yet confirmed by a user.
  DISCOVERED
  /// User confirmed the match — document queued for local copy.
  IMPORT_PENDING
  /// Download + local storage in progress (set at start of import attempt).
  IMPORTING
  /// File successfully downloaded, stored locally, and hash computed.
  IMPORTED
  /// Import failed (download error, storage error, unsupported type).
  /// Check importError for the safe failure reason.
  IMPORT_FAILED
  /// Generic failure (legacy / Phase 1 use). Prefer IMPORT_FAILED for new code.
  FAILED
  /// User explicitly rejected the match — not relevant for import.
  REJECTED
}

enum CrmFormTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CrmFormFieldType {
  TEXT
  DATE
  CHECKBOX
  SIGNATURE
  INITIALS
}

enum CrmFormRequestStatus {
  SENT
  OPENED
  COMPLETED
  EXPIRED
  REVOKED
}

/// Tenant-scoped Google Drive folder configuration.
/// Each row links a tenant to a specific Drive folder for a given purpose.
/// The googleConnection (CrmEmailConnection) must have the Drive readonly scope.
/// Unique per (tenantId, purpose) — one active folder per purpose per tenant.
model CrmDriveFolder {
  id                 String                @id @default(cuid())
  tenantId           String
  googleConnectionId String
  folderId           String
  folderName         String
  purpose            CrmDriveFolderPurpose @default(LEAD_IMPORT_INBOX)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  googleConnection CrmEmailConnection @relation(fields: [googleConnectionId], references: [id], onDelete: Cascade)

  // Partial unique enforced by migration SQL: one folder per (tenantId, purpose)
  @@unique([tenantId, purpose])
  @@index([tenantId])
  @@index([googleConnectionId])
}

/// Lead document reference — links a Google Drive file to a CRM contact.
/// Phase 1: model foundation.
/// Phase 2: contactId + match fields populated by the Drive matching engine.
/// Phase 3: file download to local storage, contentHash, importedAt, importError.
/// Phase 5: text extraction status fields (textExtractionStatus, textExtractionError, textExtractedAt).
/// No AI summaries.
model CrmLeadDocument {
  id                   String                      @id @default(cuid())
  tenantId             String
  /// FK to Contact — the CRM entity this document belongs to.
  /// Nullable: may be unmatched or pending review.
  contactId            String?
  /// Which import batch triggered discovery of this document.
  importBatchId        String?
  source               CrmLeadDocumentSource       @default(GOOGLE_DRIVE)
  /// Google Drive file ID (when source=GOOGLE_DRIVE).
  googleDriveFileId    String?
  /// Google Drive folder ID from which this file was discovered.
  googleDriveFolderId  String?
  originalFileName     String
  /// Original MIME type as reported by Google Drive.
  mimeType             String?
  /// Reported file size in bytes from Drive metadata (may differ from stored size).
  sizeBytes            BigInt?
  /// SHA-256 hex hash of the stored file bytes. Computed during import.
  contentHash          String?
  /// Tenant-scoped storage key for the local copy (set after IMPORTED).
  storageKey           String?
  status               CrmLeadDocumentStatus       @default(DISCOVERED)
  /// HIGH | MEDIUM | AMBIGUOUS — confidence of the name-match algorithm.
  matchConfidence      String?
  /// Machine reason code, e.g. "exact_company_name", "file_contains_company".
  matchReason          String?
  /// User who confirmed or rejected this document match.
  reviewedByUserId     String?
  reviewedAt           DateTime?
  /// When the file was successfully stored locally (Phase 3).
  importedAt           DateTime?
  /// Short safe error message if status=IMPORT_FAILED (Phase 3).
  importError          String?
  /// MIME type of the file actually stored — may differ from mimeType when
  /// a Google Workspace file (Docs/Sheets/Slides) is exported to PDF (Phase 3).
  importedMimeType     String?
  /// Phase 5: denormalized extraction status mirror (null = not yet attempted).
  /// Source of truth is CrmLeadDocumentText.extractionStatus; this field is for
  /// fast filtering (e.g. "find all IMPORTED docs without completed extraction").
  textExtractionStatus CrmDocTextExtractionStatus?
  /// Safe error message if text extraction failed (no content, no paths).
  textExtractionError  String?
  /// When text extraction last completed successfully.
  textExtractedAt      DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  importBatch      CrmImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  reviewedBy       User?                    @relation("CrmLeadDocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  textExtraction   CrmLeadDocumentText?
  discoveredPhones CrmLeadDiscoveredPhone[]
  discoveredEmails CrmLeadDiscoveredEmail[]

  // Unique per (tenant, batch, Drive file) — partial, enforced in migration SQL WHERE both NOT NULL.
  // This replaced the over-broad Phase 1 (tenantId, googleDriveFileId) constraint.
  // Enables the same Drive file to appear in separate import batches for the same tenant.
  @@unique([tenantId, importBatchId, googleDriveFileId])
  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@index([importBatchId])
  @@index([tenantId, googleDriveFolderId])
  @@index([tenantId, textExtractionStatus])
}

/// Tenant-scoped reusable PDF form template.
/// File contents are stored outside the DB using a tenant-scoped storage key.
model CrmFormTemplate {
  id               String                @id @default(cuid())
  tenantId         String
  name             String
  description      String?
  category         String?
  originalFileName String
  storageKey       String
  mimeType         String
  sizeBytes        BigInt
  status           CrmFormTemplateStatus @default(DRAFT)
  pageCount        Int?
  pdfMetadata      Json?
  createdByUserId  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation("CrmFormTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fields      CrmFormField[]
  requests    CrmFormRequest[]
  submissions CrmFormSubmission[]

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, updatedAt])
}

/// Manual or detected fields for a reusable CRM form template.
/// Coordinates are normalized PDF-space values saved for future overlay editors.
model CrmFormField {
  id             String           @id @default(cuid())
  tenantId       String
  formTemplateId String
  fieldType      CrmFormFieldType
  label          String
  /// Optional merge token (e.g. "contact.fullName") — resolved from the contact
  /// profile when the form is loaded by the signer. Matches CRM_FORM_MERGE_FIELDS.
  autoFillToken  String?
  required       Boolean          @default(false)
  pageNumber     Int
  x              Float
  y              Float
  width          Float
  height         Float
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formTemplate CrmFormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)

  @@index([tenantId, formTemplateId])
  @@index([formTemplateId, sortOrder])
}

/// One secure public-link request for a contact to complete a form.
/// tokenHash stores the SHA-256 hash of the random token; the raw token is never persisted.
model CrmFormRequest {
  id              String               @id @default(cuid())
  tenantId        String
  contactId       String
  formTemplateId  String
  status          CrmFormRequestStatus @default(SENT)
  recipientEmail  String
  tokenHash       String               @unique
  message         String?
  expiresAt       DateTime
  sentAt          DateTime             @default(now())
  openedAt        DateTime?
  completedAt     DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  formTemplate CrmFormTemplate    @relation(fields: [formTemplateId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("CrmFormRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submission   CrmFormSubmission?

  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, formTemplateId, createdAt])
  @@index([tenantId, status, expiresAt])
}

/// Completed public form submission. Stores structured field values and optional completed PDF key.
model CrmFormSubmission {
  id                     String   @id @default(cuid())
  tenantId               String
  formRequestId          String   @unique
  contactId              String
  formTemplateId         String
  submittedData          Json
  completedPdfStorageKey String?
  ipAddressHash          String?
  userAgent              String?
  submittedAt            DateTime @default(now())

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formRequest  CrmFormRequest  @relation(fields: [formRequestId], references: [id], onDelete: Cascade)
  contact      Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  formTemplate CrmFormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Restrict)

  @@index([tenantId, contactId, submittedAt])
  @@index([tenantId, formTemplateId, submittedAt])
}

// ─── CRM Document Text Extraction (Phase 5) ──────────────────────────────────

/// Extraction status lifecycle:
///   TEXT_PENDING → TEXT_PROCESSING → TEXT_COMPLETE
///                                  → TEXT_FAILED (retryable)
enum CrmDocTextExtractionStatus {
  TEXT_PENDING
  TEXT_PROCESSING
  TEXT_COMPLETE
  TEXT_FAILED
}

/// How the text was extracted.
/// pdf_text_layer — PDF with embedded text (pdf-parse library)
/// pdf_text_layer — native PDF text layer via pdf-parse
/// plain_text     — .txt / .csv / other plain-text MIME
/// docx_text      — DOCX via mammoth library
/// unsupported    — file type has no supported extractor in this version
/// future_ocr     — reserved for scanned-image OCR (not yet implemented); kept for
///                  backward-compatibility with rows created before Phase 5B
/// tesseract_js   — Tesseract.js WASM OCR for PNG/JPG/JPEG images (Phase 5B)
enum CrmDocTextExtractionProvider {
  pdf_text_layer
  plain_text
  docx_text
  unsupported
  future_ocr
  tesseract_js
}

// ── Pipeline run tracking ────────────────────────────────────────────────────

/// Status of an orchestrated import batch pipeline run.
/// PENDING  — created, not yet started
/// RUNNING  — processing (short-lived since pipeline is synchronous per call)
/// COMPLETE — all steps done and no more work remaining
/// PARTIAL  — progress made but work remains or some docs failed
/// FAILED   — pipeline could not start (e.g. no Drive folder configured)
/// CANCELLED — manually cancelled by user
enum CrmPipelineRunStatus {
  PENDING
  RUNNING
  COMPLETE
  PARTIAL
  FAILED
  CANCELLED
}

/// Tracks one "Process Batch" invocation for a CRM import batch.
/// Each Start creates a new run; Continue updates the latest PARTIAL run.
/// steps JSON stores per-step results (see batchPipelineService.ts for shape).
/// totals JSON stores aggregated progress counts across pipeline steps.
/// errors JSON stores safe error summaries (capped at 10).
model CrmImportBatchPipelineRun {
  id              String               @id @default(cuid())
  tenantId        String
  importBatchId   String
  status          CrmPipelineRunStatus @default(PENDING)
  startedByUserId String?
  /// Step currently running or last completed. Null when PENDING.
  currentStep     String?
  /// Per-step results. Shape: { [stepName]: StepRecord }
  steps           Json                 @default("{}")
  /// Aggregate pipeline totals.
  totals          Json                 @default("{}")
  /// Safe error list (no document text, no keys). Capped at 10 entries.
  errors          Json                 @default("[]")
  startedAt       DateTime?
  completedAt     DateTime?
  /// Set when a stale RUNNING run is automatically recovered to FAILED by the
  /// stale-run recovery mechanism (triggered on next start/continue call).
  recoveredAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importBatch CrmImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([tenantId, importBatchId])
  @@index([tenantId, status])
}

/// Stores the extracted text content and metadata for an imported CRM document.
/// One row per document (unique on documentId).
/// Created/replaced by the text extraction service; never deleted independently.
model CrmLeadDocumentText {
  id                   String                       @id @default(cuid())
  tenantId             String
  documentId           String                       @unique
  /// Denormalized for fast tenant-scoped queries without joining CrmLeadDocument.
  contactId            String?
  importBatchId        String?
  /// The full extracted text. Empty string if extraction failed.
  text                 String                       @default("")
  /// Page count from PDF metadata; null for non-PDF types.
  pageCount            Int?
  /// Character count of the extracted text field.
  charCount            Int                          @default(0)
  extractionProvider   CrmDocTextExtractionProvider
  extractionStatus     CrmDocTextExtractionStatus   @default(TEXT_PENDING)
  /// Safe error message (no document content, no storage paths, no tokens).
  extractionError      String?
  extractedAt          DateTime?
  /// OCR confidence score (0–100); null for non-OCR providers.
  extractionConfidence Float?
  /// Provider-specific metadata JSON. For tesseract_js:
  ///   { "ocrEngine": "tesseract_js", "language": "eng", "pageCount": 1 }
  /// Never stores document content or storage paths.
  extractionMetadata   Json?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  document CrmLeadDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  discoveredPhones CrmLeadDiscoveredPhone[]
  discoveredEmails CrmLeadDiscoveredEmail[]

  @@index([tenantId, documentId])
  @@index([tenantId, extractionStatus])
  @@index([contactId])
  @@index([importBatchId])
}

// ─── CRM Contact Discovery (Phase 6) ─────────────────────────────────────────

/// Discovery status lifecycle:
///   PENDING  → ACCEPTED (value attached to contact)
///           → REJECTED (dismissed; record kept for audit)
/// Re-running discovery never reopens ACCEPTED or REJECTED records.
enum CrmDiscoveryStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A phone number discovered in an imported document's extracted text.
/// One row per (tenant, contact, normalizedPhone, document) — unique index prevents
/// duplicate discoveries when extraction or discovery is rerun.
model CrmLeadDiscoveredPhone {
  id              String             @id @default(cuid())
  tenantId        String
  contactId       String
  documentId      String
  documentTextId  String
  /// Raw phone text as found in the document (e.g. "(555) 123-4567")
  phoneNumber     String
  /// Digits-only normalized form for dedup (e.g. "5551234567")
  normalizedPhone String
  /// HIGH — valid US format + near phone label; MEDIUM — valid format only
  confidence      String             @default("MEDIUM")
  /// Up to 200 chars of surrounding text. Never the full document text.
  sourceSnippet   String?
  sourcePage      Int?
  status          CrmDiscoveryStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  document     CrmLeadDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentText CrmLeadDocumentText @relation(fields: [documentTextId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId, normalizedPhone, documentId])
  @@index([tenantId, contactId])
  @@index([tenantId, status])
  @@index([documentId])
}

/// An email address discovered in an imported document's extracted text.
/// One row per (tenant, contact, email, document) — unique index prevents duplicates.
model CrmLeadDiscoveredEmail {
  id             String             @id @default(cuid())
  tenantId       String
  contactId      String
  documentId     String
  documentTextId String
  /// Email as extracted (lowercased)
  email          String
  /// HIGH — valid format; MEDIUM — plausible but unusual
  confidence     String             @default("HIGH")
  /// Up to 200 chars of surrounding text.
  sourceSnippet  String?
  sourcePage     Int?
  status         CrmDiscoveryStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  document     CrmLeadDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentText CrmLeadDocumentText @relation(fields: [documentTextId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId, email, documentId])
  @@index([tenantId, contactId])
  @@index([tenantId, status])
  @@index([documentId])
}

// ─── CRM Lead Intelligence (Phase 7) ─────────────────────────────────────────

/// AI-generated report status.
///   PENDING    — report queued, not yet started
///   PROCESSING — AI call in progress
///   COMPLETE   — report generated successfully; output fields are populated
///   FAILED     — AI call failed; error field has safe message
enum CrmLeadIntelligenceStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

/// AI-generated lead intelligence report for a contact.
/// One row per contact (unique on contactId). Upserted on force-regeneration.
/// All output is advisory only — no auto-modification of contact data.
model CrmLeadIntelligenceReport {
  id                   String                    @id @default(cuid())
  tenantId             String
  /// One report per contact — upserted on force regeneration.
  contactId            String                    @unique
  importBatchId        String?
  status               CrmLeadIntelligenceStatus @default(PENDING)
  /// 2-3 sentence executive summary.
  summary              String?
  /// Paragraph describing the company/lead's business.
  businessOverview     String?
  /// Structured findings: phoneCount, emailCount, documentCount, namesFound[], addressesFound[].
  keyFindings          Json?
  /// Structured entities extracted: phones[], emails[], websites[], names[], addresses[].
  discoveredEntities   Json?
  /// Array of risk flag codes: "missing_primary_phone", "conflicting_addresses", etc.
  riskFlags            Json?
  /// Array of missing-info codes: "missing_owner", "missing_email", etc.
  missingInformation   Json?
  /// 0.0–1.0; AI-assessed confidence based on input data quality.
  confidenceScore      Float?
  /// Model that generated this report, e.g. "gpt-4o-mini".
  modelName            String?
  generatedAt          DateTime?
  /// Safe error message (no document content, no tokens, ≤ 500 chars).
  error                String?
  /// Source counts that were fed into the AI call.
  sourceDocumentCount  Int                       @default(0)
  sourceTextCount      Int                       @default(0)
  sourceDiscoveryCount Int                       @default(0)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  /// Total characters of all document snippets sent to the AI.
  promptCharCount      Int?
  /// Documents actually included in the AI prompt (after limit enforcement).
  documentsIncluded    Int?
  /// Documents excluded due to per-tenant limits.
  documentsExcluded    Int?
  /// Wall-clock duration of the AI provider call in milliseconds.
  generationDurationMs Int?
  /// Provider name, e.g. "openai".
  providerName         String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@index([importBatchId])
}

// ─── CRM AI Governance Settings (Phase 7B) ───────────────────────────────────

/// Per-tenant AI generation settings and limits.
/// Absence of a row = all defaults (see field defaults below).
/// Limits have hard server-side caps enforced in leadIntelligenceService.ts
/// regardless of what is stored here.
model CrmAiSettings {
  id                          String   @id @default(cuid())
  tenantId                    String   @unique
  /// Master switch — false blocks all AI generation for this tenant.
  aiEnabled                   Boolean  @default(true)
  /// Max imported documents included per report. Hard server cap: 10.
  maxDocumentsPerReport       Int      @default(5)
  /// Max extracted text characters per document. Hard server cap: 5000.
  maxCharsPerDocument         Int      @default(2000)
  /// Max total characters across all documents in one prompt. Hard server cap: 25000.
  maxTotalCharsPerReport      Int      @default(10000)
  /// Whether batch generation (/crm/import/batches/:id/intelligence) is allowed.
  allowBatchGeneration        Boolean  @default(true)
  /// Max contacts processed per single batch call. Hard server cap: 25.
  maxBatchReportsPerRun       Int      @default(25)
  /// Minimum minutes between force-regenerations for the same contact.
  /// 0 = no cooldown. CRM admin role can bypass.
  regenerationCooldownMinutes Int      @default(60)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── PBX Observability & Diagnostics (Phase 1 — read-only) ─────────────────────
// See docs/pbx/connect-pbx-observability-phase1-blueprint.md and
// docs/pbx/connect-pbx-observability-diagnostics-platform.md.
// These tables ONLY store mapped PBX signals Connect already receives. They never
// drive any write back to the PBX/AstDB/ombutel. All five models are additive.

/// Normalized, redacted single PBX event — the Phase 1 ingest buffer + forensic tail.
/// `tenantId` is a plain string (Connect Tenant.id | "vpbx:<slug>" | null) and is
/// intentionally NOT a foreign key, mirroring ConnectCdr.tenantId, so event ingest
/// never blocks on tenant resolution and never cascades.
/// This is the highest-volume diagnostics table — it gets the SHORTEST retention
/// (default 7d). `occurredAt` is the retention/partition pruning key.
model PbxEvent {
  id               String   @id @default(cuid())
  /// Idempotent dedupe key: sha256(source|eventType|linkedId|uniqueId|channel|occurredAt).
  eventKey         String   @unique
  source           String // "ami" | "ari" | "cdr" | "system"
  eventType        String // e.g. "Newchannel" | "DialBegin" | "Hangup"
  occurredAt       DateTime // event time as reported by the PBX/Asterisk
  ingestedAt       DateTime @default(now())
  /// NOT globally 1:1 with a call — attended/blind transfers create multiple linkedIds.
  linkedId         String?
  uniqueId         String?
  channel          String?
  bridgeId         String?
  tenantId         String? // Connect Tenant.id | "vpbx:<slug>" | null (no FK by design)
  tenantSlug       String?
  extension        String?
  did              String?
  callerNumber     String?
  calleeNumber     String?
  /// Redacted residual fields only — never SIP secrets/passwords/tokens.
  metadata         Json?
  redactionVersion Int      @default(1)
  pbxInstanceId    String?
  createdAt        DateTime @default(now())

  @@index([linkedId])
  @@index([uniqueId])
  @@index([tenantId, occurredAt])
  @@index([source, eventType])
  @@index([occurredAt])
}

/// One logical call. `rootLinkedId` is the primary correlation key, but a single
/// call can span MULTIPLE linkedIds after attended/blind transfers — hence
/// `linkedIds[]` + `completeness`. Populated by the Phase 1 assembler (NOT Step 0/1).
model PbxCallTrace {
  id                  String    @id @default(cuid())
  rootLinkedId        String    @unique
  /// All linkedIds stitched into this call (transfer correlation).
  linkedIds           String[]
  tenantId            String?
  tenantSlug          String?
  direction           String?
  /// Axis A terminal disposition: answered|voicemail|missed|busy|canceled|failed|unknown.
  disposition         String?
  /// Axis B optional failure class (e.g. queue_abandoned, ring_group_no_answer).
  failureClass        String?
  did                 String?
  callerNumber        String?
  callerIdName        String?
  destinationNumber   String?
  connectedNumber     String?
  trunk               String?
  answeredByExtension String?
  hangupCause         String?
  /// "partial" | "complete" | "stitched"
  completeness        String    @default("partial")
  cdrId               String?
  startedAt           DateTime?
  answeredAt          DateTime?
  endedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  participants PbxCallParticipant[]
  routeSteps   PbxCallRouteStep[]

  @@index([tenantId, startedAt])
  @@index([did])
  @@index([callerNumber])
  @@index([destinationNumber])
  @@index([trunk])
  @@index([failureClass])
  @@index([hangupCause])
  @@index([startedAt])
}

/// A leg/participant of a call trace (caller, callee, trunk, queue member).
model PbxCallParticipant {
  id          String    @id @default(cuid())
  traceId     String
  role        String // "caller" | "callee" | "trunk" | "queue_member"
  extension   String?
  deviceName  String?
  sipUsername String?
  channel     String?
  uniqueId    String?
  linkedId    String?
  connectedAt DateTime?
  hangupCause String?
  createdAt   DateTime  @default(now())

  trace PbxCallTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId])
  @@index([extension])
  @@index([sipUsername])
  @@index([deviceName])
}

/// An ordered step in a call's route (did_matched, tenant_resolved, ivr, dtmf,
/// queue, ringgroup, dial, bridge, voicemail, hangup, ...).
model PbxCallRouteStep {
  id            String   @id @default(cuid())
  traceId       String
  seq           Int
  stepType      String
  occurredAt    DateTime
  ivrName       String?
  queueName     String?
  ringGroup     String?
  routeRef      String?
  details       Json?
  sourceEventId String?
  createdAt     DateTime @default(now())

  trace PbxCallTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([traceId, seq])
  @@index([stepType])
  @@index([queueName])
  @@index([ringGroup])
}

/// Per-instance / per-data-class retention + disk guardrail config for the
/// diagnostics store. Connect-owned configuration only — never a PBX write.
model PbxStorageRetentionPolicy {
  id                   String   @id @default(cuid())
  pbxInstanceId        String?
  dataClass            String // "pbx_event" | "call_trace" | "route_step" | "participant"
  retentionDays        Int
  archiveEnabled       Boolean  @default(false)
  diskHighWatermarkPct Int      @default(85)
  diskLowWatermarkPct  Int      @default(75)
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([pbxInstanceId, dataClass])
}

/// Current PBX registration state for a single pjsip endpoint / AOR (e.g.
/// "T25_101_1"). Populated by the telephony service forwarding AMI
/// ContactStatus / PeerStatus events to POST /internal/pbx/contact-status.
/// This is the authoritative, app-independent "is this device registered at
/// the PBX right now" signal used by the device-registration watchdog,
/// admin dashboard, and alerting. Plain scalar FKs (no relations) to keep the
/// write path cheap and avoid coupling to Tenant/Extension/MobileDevice.
model PbxEndpointRegistration {
  id                 String    @id @default(cuid())
  /// pjsip endpoint / AOR name, e.g. "T25_101_1". Globally unique on the PBX.
  endpoint           String    @unique
  /// Connect tenant id, resolved from the endpoint prefix when possible.
  tenantId           String?
  /// Connect Extension.id, resolved from the endpoint when possible.
  extensionId        String?
  /// VitalPBX numeric tenant id parsed from the "T<n>_" prefix.
  pbxTenantNumber    String?
  /// Extension number parsed from the endpoint (e.g. "101").
  extNumber          String?
  /// True when the endpoint name carries a device suffix (WebRTC/mobile, e.g. "_1").
  isWebrtcDevice     Boolean   @default(false)
  /// Normalized state: "REGISTERED" | "UNREACHABLE" | "UNREGISTERED" | "UNKNOWN".
  status             String    @default("UNKNOWN")
  /// Last raw AMI ContactStatus value (Reachable/Unreachable/Removed/Created/NonQualified...).
  rawStatus          String?
  /// Most-recent contact URI seen for this endpoint.
  contactUri         String?
  /// Most-recent SIP User-Agent reported by the contact.
  userAgent          String?
  /// Last qualify round-trip in microseconds (0/empty when not measured).
  roundtripUsec      String?
  lastRegisteredAt   DateTime?
  lastUnreachableAt  DateTime?
  lastUnregisteredAt DateTime?
  /// Timestamp of the most recent status event of any kind.
  lastEventAt        DateTime  @default(now())
  /// Source of the last update: "ami_contactstatus" | "ami_peerstatus" | "ami_bootstrap".
  source             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([tenantId, status])
  @@index([extensionId])
  @@index([lastEventAt])
}

/// Append-only history of PBX registration state transitions for an endpoint.
/// Powers the "why did this device go Not Registered" timeline in the admin UI.
/// Pruned by the worker after ~14 days.
model PbxEndpointRegistrationEvent {
  id          String   @id @default(cuid())
  endpoint    String
  tenantId    String?
  extensionId String?
  /// Normalized status at this event ("REGISTERED" | "UNREACHABLE" | "UNREGISTERED" | "UNKNOWN").
  status      String
  rawStatus   String?
  contactUri  String?
  userAgent   String?
  details     Json?
  occurredAt  DateTime @default(now())

  @@index([endpoint, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([occurredAt])
}

// ─── AI Support Agent ("Shammes") — docs/ai-support-agent/PLAN.md §5 ──────────
// Additive only. Every PBX-affecting action is approval-gated; every event is
// audit-logged. NOTHING here may weaken the PBX read-only safeguard.

enum AgentConversationStatus {
  OPEN
  CLOSED
}

enum AgentChannel {
  CHAT
  EMAIL
  WHATSAPP
  SMS
  PHONE
}

enum AgentActionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EXECUTING
  EXECUTED
  REVERTED
  DENIED
  EXPIRED
  FAILED
}

/// One support chat session. Every new issue = a new conversation (auto-closed
/// on resolution or 12h inactivity). Stored permanently; client visibility of
/// past chats is gated per tenant by AgentPolicy.historyVisible.
model AgentConversation {
  id                String                  @id @default(cuid())
  tenantId          String
  clientUserId      String?
  role              String                  @default("customer") /// "owner" | "customer"
  channel           AgentChannel            @default(CHAT)
  language          String? /// detected: "en" | "yi"
  status            AgentConversationStatus @default(OPEN)
  startedAt         DateTime                @default(now())
  closedAt          DateTime?
  /// X2: when this closed conversation's summary landed in the user's dossier.
  /// Null on CLOSED rows = pending sweep (idempotent, crash-safe).
  dossierRecordedAt DateTime?
  messages          AgentMessage[]

  @@index([tenantId, startedAt])
  @@index([tenantId, status])
  @@index([status, dossierRecordedAt])
}

/// X2: every user's running markdown dossier — a summary block per closed
/// conversation plus a compacted digest of older ones. RECORDING IS
/// UNCONDITIONAL (Izzy, 2026-07-23): written for every tenant/user, always;
/// the history visibility toggle affects display only, never recording.
model AgentUserDossier {
  id           String   @id @default(cuid())
  tenantId     String
  clientUserId String
  dossierMd    String   @default("")
  /// Optimistic-concurrency revision (compare-and-set on update).
  rev          Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, clientUserId])
  @@index([tenantId])
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id])
  role           String /// "user" | "assistant" | "system" | "tool"
  content        String
  contentEn      String? /// English mirror when the YL translate-bridge is active (Yiddish chats). Feeds the LLM + the tuning corpus.
  audioUrl       String?
  transcript     String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

/// Persistent translation cache for the Yiddish Labs bridge. Keyed by
/// (action, srcHash). A hit returns instantly with zero YL credits, so fixed
/// templates + repeated phrases never re-hit YL's ~9s output leg. Additive.
model AgentTranslation {
  id        String   @id @default(cuid())
  action    String /// translate-yiddish | translate-english | translate-hebrew | translate-lk
  srcHash   String /// sha256(normalized srcText), truncated
  srcText   String /// normalized source (truncated), for review/debug
  outText   String /// translated output (the cached value)
  hits      Int      @default(0)
  pinned    Boolean  @default(false) /// pre-warmed template — never evicted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([action, srcHash])
  @@index([action, srcHash])
}

/// A requested change. Client actions wait in PENDING_APPROVAL for a human;
/// owner-requested actions are auto-approved (owner's word) but still pre-flight
/// checked, executed via the scoped executor, audited, and emailed.
model AgentAction {
  id                 String            @id @default(cuid())
  tenantId           String
  conversationId     String?
  capabilityId       String /// e.g. "action.A1.temp_forward" — must exist in the certified manifest
  params             Json
  riskTier           String            @default("low")
  status             AgentActionStatus @default(DRAFT)
  summary            String /// plain-English description + exact diff shown to approver
  requestedBy        String /// user id or "owner"
  requestedRole      String            @default("customer")
  approvedBy         String?
  approvalToken      String?           @unique /// signed token for email approve/deny links
  deniedReason       String?
  executedAt         DateTime?
  revertAt           DateTime? /// scheduler enforces even across restarts
  revertedAt         DateTime?
  revertOfId         String?           @unique /// set on the mirror action that undoes this one
  resultSnapshot     Json? /// pre-change state captured for revert/rollback
  errorDetail        String?
  paramsHash         String? /// X1: sha256 binding of capability+tenant+frozen params (modify/repair caps only)
  approvalConsumedAt DateTime? /// X1: single-use approval consumption timestamp (modify/repair caps only)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([status, revertAt])
  @@index([createdAt])
}

/// Append-only audit trail (DB twin of the JSONL file export).
model AgentAuditLog {
  id             String   @id @default(cuid())
  ts             DateTime @default(now())
  actor          String /// "agent" | "model" | "owner" | "customer" | "system" | "watchman"
  event          String
  tenantId       String?
  conversationId String?
  actionId       String?
  capabilityId   String?
  payload        Json?
  hash           String /// sha256 of the row body — tamper evidence

  @@index([ts])
  @@index([tenantId, ts])
  @@index([event, ts])
}

/// Per-tenant permission policy for the customer-facing agent (PLAN.md §6a).
/// Whitelist semantics: a capability absent from grants is blocked.
model AgentPolicy {
  id             String   @id @default(cuid())
  tenantId       String   @unique /// special row tenantId="__owner__" holds the owner policy
  version        Int      @default(1)
  grants         Json /// { [capabilityId]: { mode, limits, businessHoursOnly, protectedExtensions } }
  historyVisible Boolean  @default(false)
  channels       String[] @default(["chat"])
  updatedBy      String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model AgentDiagReport {
  id             String   @id @default(cuid())
  tenantId       String
  extension      String?
  severity       String   @default("medium")
  findings       Json /// checks performed, evidence
  hypotheses     Json /// ranked root causes with confidence
  recommendation String?
  sentTo         String[]
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Watchman detections (security + health). Read-only monitoring; humans act.
model AgentIncident {
  id         String    @id @default(cuid())
  type       String /// e.g. "sip_bruteforce" | "toll_fraud_pattern" | "service_down" | "cert_expiry"
  severity   String /// "info" | "warning" | "critical"
  evidence   Json
  status     String    @default("open") /// "open" | "acknowledged" | "resolved"
  notifiedAt DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([severity, createdAt])
  @@index([status])
}

model AgentKbArticle {
  id                   String   @id @default(cuid())
  tenantId             String? /// null = global knowledge
  title                String
  problem              String
  cause                String
  fix                  String
  approved             Boolean  @default(false) /// team approves drafts before the agent cites them
  sourceConversationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId, approved])
}

/// Trainer-mode lessons: a designated tester corrects the agent in chat
/// ("add that to your memory") and the lesson takes effect IMMEDIATELY for that
/// tenant's conversations. Every lesson carries who/when; the owner can revoke
/// any lesson from the AI Trainer page. Audit events: trainer.lesson_added /
/// trainer.lesson_revoked.
enum AgentEscalationStatus {
  QUEUED
  SENT
  FAILED
  /// Withdrawn by the requester (agent tool cancel_my_requests) before it was
  /// sent. The dispatcher only sweeps QUEUED/FAILED, so a cancelled row is
  /// naturally never dispatched.
  CANCELLED
}

/// One customer request the assistant could not handle itself, researched and
/// packaged for the owner's decision. The AGENT detects + researches + writes
/// the row; the API's dispatcher sends the SMS (to the owner's numbers, from
/// Connect's escalation number) and the email report, because the agent
/// container is a manual rebuild and must never be the only thing standing
/// between a customer and the owner hearing about it.
model AgentEscalation {
  id             String                @id @default(cuid())
  conversationId String?
  tenantId       String
  tenantName     String
  clientUserId   String?
  userName       String
  userEmail      String?
  /// What the customer asked, in one or two sentences.
  requestSummary String
  /// Compact report for the SMS (tenant + user + issue + proposed fix).
  smsBody        String
  /// Full report for the email: issue, findings, exact proposed fix, approval line.
  report         String
  /// The exact fix the agent proposes, alone — for screens and follow-ups.
  proposedFix    String
  /// True when the research LLM was unavailable and the report is only the raw request.
  researchDegraded Boolean             @default(false)
  status         AgentEscalationStatus @default(QUEUED)
  attempts       Int                   @default(0)
  lastError      String?
  smsSentAt      DateTime?
  emailQueuedAt  DateTime?

  /// ── "Fix it!" by text ───────────────────────────────────────────────────
  /// The DRAFT AgentAction this escalation offers to carry out, if the request
  /// maps to one of the safe capabilities. Null means the escalation is
  /// information only and the SMS carries no code — most of them.
  fixActionId      String?
  /// sha256 of the one-time code. ⛔ The code itself is NEVER stored: the SMS
  /// is the only place it exists in the clear, which is what makes replying
  /// with it proof that the owner read the message.
  fixCodeHash      String?  @unique
  fixCodeExpiresAt DateTime?
  /// Set the moment a reply claims the code, before the work runs — the claim
  /// is what makes it single-use, so a second text can never act twice.
  fixCodeUsedAt    DateTime?
  /// Which phone approved it, for the audit trail.
  fixApprovedFrom  String?
  /// null | "offered" | "applied" | "refused" | "failed"
  fixStatus        String?
  /// Plain-English outcome, mirrored into the reply SMS.
  fixResult        String?
  /// Counts refused attempts against this escalation, so a guessed code costs
  /// something even before the platform-wide rate limit bites.
  fixAttempts      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

model AgentTrainerLesson {
  id                   String    @id @default(cuid())
  tenantId             String
  lesson               String /// the distilled rule the agent must follow going forward
  rawText              String /// the trainer's original chat message, verbatim
  createdById          String /// Connect user id of the trainer
  createdByName        String?
  sourceConversationId String?
  active               Boolean   @default(true)
  revokedAt            DateTime?
  revokedBy            String?
  createdAt            DateTime  @default(now())

  @@index([tenantId, active, createdAt])
}

/// Per-tenant facts the agent learns ("Brooklyn office", device models, prefs).
model AgentMemory {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

/// Standing knowledge the assistant reads BEFORE it answers — one document for
/// the platform ("system") and one per company ("tenant"). Split on purpose:
/// a conversation loads the system doc plus THAT company's doc and nothing
/// else, so knowledge grows with the customer base without growing the prompt.
///
/// ⛔ The markdown files in `docs/agent-knowledge/` are the SOURCE OF TRUTH —
/// this table is the published copy the agent reads. The api re-syncs the
/// files into these rows at boot (`agentKnowledgeSync.ts`), so editing a file
/// and deploying the api publishes it; the agent container never needs a
/// rebuild to learn something new. Rows written from a file carry
/// source="repo" and are removed when their file is deleted.
///
/// ⛔ `body` is what a CUSTOMER can be told. Staff-only material lives between
/// `<!-- internal -->` markers inside the file and is stripped into
/// `internalBody`, which only the escalation researcher ever sees.
model AgentKnowledgeDoc {
  id       String  @id @default(cuid())
  /// "system" (platform-wide, tenantId null) or "tenant".
  scope    String
  /// Which company this doc belongs to. Null for the system doc. No FK by
  /// design — every other Agent* table does the same, and a knowledge row must
  /// never be the reason a tenant delete fails.
  tenantId String?
  /// Stable file identity: "system" or the tenant file's basename.
  slug     String  @unique
  title    String
  /// Customer-safe knowledge, markdown.
  body     String
  /// Staff-only knowledge, markdown. Never reaches a customer-facing reply.
  internalBody String?
  /// sha256 of the source file — lets a sync skip unchanged documents.
  checksum String
  /// "repo" (published from docs/agent-knowledge) or "manual".
  source   String  @default("repo")
  /// Relative path of the file this came from, for error messages.
  sourcePath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, tenantId])
}

model AgentTranscript {
  id          String   @id @default(cuid())
  tenantId    String?
  recordingId String   @unique
  language    String? /// "en" | "yi" | "yi-en" (code-switched)
  text        String
  diarization Json?
  model       String? /// "whisper" | "everett" | tuned model id
  createdAt   DateTime @default(now())

  // ── Yiddish tuning flywheel (docs/ai-support-agent/YIDDISH_TUNING.md) ──
  /// where this sample came from: "live_call" | "news_hotline" | "bulk_import" | "correction"
  source           String    @default("live_call")
  /// STT confidence 0..1 (drives the correction queue: low → review).
  confidence       Float?
  /// audio pointer (path/URL) so the (audio,text) pair can be exported for tuning.
  audioRef         String?
  /// human-corrected transcript; when set this is the "gold" training text.
  correctedText    String?
  correctedBy      String?
  correctedAt      DateTime?
  /// may this sample be used for model tuning? (consent + retention). Default off.
  trainingEligible Boolean   @default(false)
  /// review workflow: "none" | "pending" | "corrected" | "approved"
  reviewStatus     String    @default("none")
  /// glossary/slang terms detected in this transcript (for LM + analytics).
  glossaryHits     Json?

  @@index([tenantId, createdAt])
  @@index([source, reviewStatus])
  @@index([trainingEligible, language])
}

/// Owner-managed secrets (API keys) entered via the Assistant page, encrypted
/// at rest (AES-256-GCM via @connect/security). Values are write-only from the
/// UI and never returned. The agent reads these first, falling back to env.
model AgentSecret {
  id        String   @id @default(cuid())
  key       String   @unique /// "anthropic_api_key" | "openai_api_key" | "yiddishlabs_api_key"
  valueEnc  String /// encrypted envelope; never logged or returned
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Dialect glossary — heimishe NY-Yiddish slang, loshn-koydesh, names, and the
/// Yinglish code-switch spellings. Biases STT decoding (phrase boost) and seeds
/// the domain language model for fine-tuning. Grows as the team spots misses.
model AgentDialectTerm {
  id          String   @id @default(cuid())
  /// the term as it should appear in transcripts (canonical spelling).
  term        String
  /// alternate spellings / mis-hearings the model tends to produce.
  variants    String[] @default([])
  /// "slang" | "loshn_koydesh" | "name" | "yinglish" | "business" | "place"
  category    String   @default("slang")
  /// optional English gloss / meaning for the LM + human reviewers.
  gloss       String?
  /// English word commonly code-switched in (for yinglish category).
  englishForm String?
  weight      Int      @default(1)
  addedBy     String?
  createdAt   DateTime @default(now())

  @@unique([term])
  @@index([category])
}

/// Ownership Ledger (PBX_PROVISIONING_PLAN.md §4). EVERY PBX object the agent
/// creates is recorded here. The Scoped Executor may only ever edit/delete a
/// PBX object whose id appears in this ledger — anything absent is, by
/// definition, pre-existing / not ours, and is untouchable. This is the
/// structural guarantee that existing tenants and call flows are never altered.
model AgentPbxObject {
  id                String   @id @default(cuid())
  /// e.g. "tenant" | "extension" | "ivr" | "inbound_route" | "ring_group" | "queue" | "time_condition" | "outbound_route" | "device" | "conference" | "parking_lot" | "ivr_prompt"
  pbxObjectType     String
  /// The id/key returned by VitalPBX for the created object.
  pbxObjectId       String
  /// VitalPBX tenant this object lives under (for scoping). Null for the tenant object itself.
  pbxTenantId       String?
  /// Connect tenant id when applicable.
  connectTenantId   String?
  /// The AgentAction that created it (audit chain).
  createdByActionId String?
  /// "active" | "deleted" | "rolled_back"
  state             String   @default("active")
  /// Was this created in simulation mode (not a real PBX object)? Keeps sim + live cleanly separated.
  simulated         Boolean  @default(false)
  meta              Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([pbxObjectType, pbxObjectId, simulated])
  @@index([pbxTenantId])
  @@index([state])
}

/// X1 (ACTIONS_V2_ROADMAP): checksummed "before photo" captured before EVERY
/// modify/repair write. Powers verify-after-write auto-revert and the owner's
/// one-click revert window. Additive table — nothing existing reads or writes it.
model AgentPbxSnapshot {
  id           String    @id @default(cuid())
  /// The AgentAction this snapshot belongs to (one snapshot per action).
  actionId     String    @unique
  capabilityId String
  tenantId     String
  /// e.g. "moh_tenant" | "inbound_route" | "ivr" — the ModifyOp kind.
  objectType   String
  objectId     String
  /// Full pre-change state of the one target object.
  stateJson    Json
  /// sha256 of the canonical JSON of stateJson — integrity-checked before any restore.
  checksum     String
  /// Which proven write path captured it: "astdb" | "api" | "helper".
  source       String
  /// Simulation snapshots never describe real PBX state.
  simulated    Boolean   @default(false)
  capturedAt   DateTime  @default(now())
  restoredAt   DateTime?
  /// One-click revert available until here (AGENT_MODIFY_REVERT_DAYS, default 7d).
  expiresAt    DateTime

  @@index([tenantId, objectType, objectId])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// SUPERMARKET DELIVERY TRACKING — Phase 2 (core domain)
// APPEND-ONLY. Paste this block at the END of packages/db/prisma/schema.prisma.
//
// Design notes:
//  - tenantId is a plain scalar (String) with the FK added in the migration SQL,
//    following the ConnectCdr precedent, so the 5,679-line Tenant/User models are
//    NOT edited. Every query filters tenantId explicitly (repo rule 1).
//  - Workflow statuses are stored as String (validated by apps/api/src/delivery/status.ts)
//    to avoid Postgres enum-ordering migration pain. No new Prisma enums are added.
//  - Relations are declared only among delivery-owned models; references to
//    Tenant / User / DeliveryStore / DriverProfile / Contact are scalar + SQL FK.
// ═══════════════════════════════════════════════════════════════════════════════

/// Per-tenant delivery feature flag + configuration. Absence of a row = disabled.
model DeliveryTenantSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  enabled              Boolean  @default(false)
  /// Customer map policy: PROGRESSIVE | FULL | NONE (decision 1).
  mapReveal            String   @default("PROGRESSIVE")
  /// Reveal the exact driver pin when the driver is within N stops.
  exactPinStopsAway    Int      @default(1)
  /// Verification policy: TIERED | STRICT | LIGHT (decision 4).
  verifyTier           String   @default("TIERED")
  /// Voice ETA mode: PRERECORDED_NUMBER_PLAYBACK | TTS | COARSE (decision 2).
  voiceMode            String   @default("PRERECORDED_NUMBER_PLAYBACK")
  /// High-resolution retention window (days) for location samples etc.
  retentionDays        Int      @default(30)
  notifyOutForDelivery Boolean  @default(true)
  notifyDelayed        Boolean  @default(true)
  notifyDelivered      Boolean  @default(true)
  notifyApproaching    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// A supermarket store location within a tenant.
model DeliveryStore {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// External reference used by the OrderSourceAdapter to map orders to stores.
  externalRef String
  timezone    String?
  lat         Float?
  lng         Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, externalRef])
  @@index([tenantId])
}

/// A delivery zone (area) belonging to a store. geojson holds the polygon.
model DeliveryZone {
  id        String   @id @default(cuid())
  tenantId  String
  storeId   String
  name      String
  geojson   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, storeId])
}

/// Overlay on a Connect User granting the driver role (decision 5).
model DriverProfile {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  status      String   @default("OFFLINE") // OFFLINE | AVAILABLE | ON_RUN
  active      Boolean  @default(true)
  activeRunId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stores DriverStore[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
}

/// Which stores a driver is permitted to work.
model DriverStore {
  id        String   @id @default(cuid())
  tenantId  String
  driverId  String
  storeId   String
  createdAt DateTime @default(now())

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, storeId])
  @@index([tenantId, storeId])
}

/// A normalized delivery order. rawSourceStatus preserves the supermarket source
/// status verbatim, separate from the normalized `status` (governed by status.ts).
model DeliveryOrder {
  id                   String    @id @default(cuid())
  tenantId             String
  storeId              String
  /// Stable id from the source system — idempotency anchor.
  sourceId             String
  rawSourceStatus      String    @default("NEW")
  status               String    @default("RECEIVED")
  contactId            String?
  customerName         String?
  customerPhone        String?
  addrLine1            String
  addrLine2            String?
  addrUnit             String?
  addrCity             String?
  addrRegion           String?
  addrPostal           String?
  instructions         String?
  lat                  Float?
  lng                  Float?
  geocodedAt           DateTime?
  requestedWindowStart DateTime?
  requestedWindowEnd   DateTime?
  priority             String    @default("NORMAL")
  signatureRequired    Boolean   @default(false)
  ageRestricted        Boolean   @default(false)
  cashOnDelivery       Boolean   @default(false)
  language             String?
  messagingConsent     Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  packages     DeliveryPackage[]
  identifiers  DeliveryOrderIdentifier[]
  statusEvents DeliveryStatusEvent[]
  assignment   DeliveryAssignment?
  runStop      DeliveryRunStop?

  @@unique([tenantId, sourceId])
  @@index([tenantId, status])
  @@index([tenantId, storeId])
}

/// A package/tote within an order.
model DeliveryPackage {
  id            String   @id @default(cuid())
  tenantId      String
  orderId       String
  label         String?
  tempSensitive Boolean  @default(false)
  createdAt     DateTime @default(now())

  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Scan-label / tracking identifier for an order. Token is stored HASHED.
model DeliveryOrderIdentifier {
  id        String   @id @default(cuid())
  tenantId  String
  orderId   String
  tokenHash String
  kind      String   @default("LABEL") // LABEL | TRACKING
  createdAt DateTime @default(now())

  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tokenHash])
  @@index([orderId])
}

/// Append-only status transition log for an order.
model DeliveryStatusEvent {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  fromStatus  String?
  toStatus    String
  actor       String
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([tenantId, createdAt])
}

/// A grouped delivery run (route) for a driver.
model DeliveryRun {
  id          String    @id @default(cuid())
  tenantId    String
  storeId     String
  driverId    String?
  status      String    @default("DRAFT") // DRAFT | ACTIVE | PAUSED | COMPLETED | CLOSED
  windowStart DateTime?
  windowEnd   DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stops DeliveryRunStop[]

  @@index([tenantId, status])
  @@index([tenantId, driverId])
}

/// An ordered stop on a run (one order per stop).
model DeliveryRunStop {
  id        String   @id @default(cuid())
  tenantId  String
  runId     String
  orderId   String   @unique
  sequence  Int
  status    String   @default("PENDING") // PENDING | ARRIVED | DONE | FAILED | SKIPPED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run   DeliveryRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([runId, orderId])
  @@index([runId, sequence])
}

/// Order↔driver assignment. Idempotent via clientOpId; one assignment per order.
model DeliveryAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String   @unique
  driverId   String
  runId      String?
  clientOpId String   @unique
  createdAt  DateTime @default(now())

  order DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, driverId])
}

/// Inbound order-source events (mock adapter now; real webhook Phase 10). Replay-friendly.
model DeliveryOrderSourceEvent {
  id          String    @id @default(cuid())
  tenantId    String
  type        String
  sourceId    String
  payload     Json
  status      String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED
  attempts    Int       @default(0)
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, status])
  @@index([tenantId, sourceId])
}

// ── SUPERMARKET DELIVERY TRACKING — Phase 3 (dispatcher RBAC) ──────────────────
// APPEND to the end of packages/db/prisma/schema.prisma (after the Phase 2 block).

/// Per-user delivery access grant (dispatcher / store-manager / etc.).
/// Absence of a row = no delivery role (platform admins still bypass).
model DeliveryUserAccess {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  /// One of: TENANT_ADMIN | STORE_MANAGER | DISPATCHER | DRIVER | CUSTOMER_SERVICE | REPORTING
  role      String   @default("DISPATCHER")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId, enabled])
}

// ── SUPERMARKET DELIVERY TRACKING — Phase 5 (live location + ETA) ──────────────
// APPEND to the end of packages/db/prisma/schema.prisma (after the Phase 3 block).
// Scalar tenantId/runId/driverId + SQL FKs (ConnectCdr precedent). Location samples are
// high-volume — see retentionDays on DeliveryTenantSettings + the retention sweep (Phase 11).

/// One tracking session per active run. Bounds when location is collected.
model DriverTrackingSession {
  id        String    @id @default(cuid())
  tenantId  String
  runId     String
  driverId  String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  endReason String? // COMPLETED | SIGNED_OUT | TIMEOUT | MANAGER_CLOSED
  createdAt DateTime  @default(now())

  samples DriverLocationSample[]

  @@index([tenantId, driverId, endedAt])
  @@index([runId])
}

/// High-frequency GPS fix. Short retention (see retention sweep).
model DriverLocationSample {
  id            String   @id @default(cuid())
  tenantId      String
  sessionId     String
  lat           Float
  lng           Float
  accuracy      Float?
  speed         Float?
  heading       Float?
  batteryPct    Int?
  mockSuspected Boolean  @default(false)
  deviceTs      DateTime
  serverTs      DateTime @default(now())

  session DriverTrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, serverTs])
  @@index([tenantId, serverTs])
}

/// An ETA computed at a point in time (audit + confidence tracking).
model EtaSnapshot {
  id         String   @id @default(cuid())
  tenantId   String
  runId      String
  orderId    String?
  stopsAway  Int
  etaMinSec  Int
  etaMaxSec  Int
  confidence String
  calcAt     DateTime @default(now())

  @@index([runId, calcAt])
}

// ── SUPERMARKET DELIVERY TRACKING — Phase 6 (customer tracking link) ───────────
/// Secure customer tracking link. Token stored HASHED; high-entropy, expiring,
/// tenant+order bound, revocable. OTP fields gate tier-2 (sensitive) detail.
model TrackingToken {
  id           String    @id @default(cuid())
  tenantId     String
  orderId      String
  tokenHash    String    @unique
  kind         String    @default("TRACKING")
  expiresAt    DateTime?
  revokedAt    DateTime?
  otpHash      String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, orderId])
}

// ── SUPERMARKET DELIVERY TRACKING — Phase 7 (SMS notifications + consent) ───────
/// Outbound customer notification log — deduped (idempotencyKey), provider-tracked.
model DeliveryNotification {
  id                String   @id @default(cuid())
  tenantId          String
  orderId           String
  trigger           String
  channel           String   @default("SMS")
  toPhone           String?
  templateVersion   String?
  body              String?
  providerMessageId String?
  status            String   @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED | TEST
  errorReason       String?
  retryCount        Int      @default(0)
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

/// Per-tenant SMS consent (STOP/START). Opt-out blocks all delivery texts.
model DeliverySmsConsent {
  id         String    @id @default(cuid())
  tenantId   String
  phoneE164  String
  optedOut   Boolean   @default(false)
  optedOutAt DateTime?
  optedInAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, phoneE164])
}

// ── SUPERMARKET DELIVERY TRACKING — Phase 9 (proof of delivery + exceptions) ────
/// Proof captured at delivery. Media stored via shared object storage (signed access only).
model ProofOfDelivery {
  id                  String   @id @default(cuid())
  tenantId            String
  orderId             String   @unique
  methods             String // comma-joined ProofMethods used (photo,signature,pin,tap,recipient_name,gps)
  handover            String?
  recipientName       String?
  photoStorageKey     String?
  signatureStorageKey String?
  gpsLat              Float?
  gpsLng              Float?
  gpsAccuracy         Float?
  overrideReason      String?
  capturedByDriverId  String?
  capturedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([tenantId, orderId])
}

/// A failed/exception event for an order (reason-coded; drives downstream behavior).
model DeliveryException {
  id                String    @id @default(cuid())
  tenantId          String
  orderId           String
  reasonCode        String
  note              String?
  photoStorageKey   String?
  needsApproval     Boolean   @default(false)
  approvedByUserId  String?
  approvedAt        DateTime?
  createdByDriverId String?
  createdAt         DateTime  @default(now())

  @@index([tenantId, orderId])
  @@index([tenantId, reasonCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// Remote support — watching and driving a customer's Windows machine.
//
// ⛔ THE RULE THIS SCHEMA ENFORCES: consent is per session, and control is
// consented SEPARATELY from viewing. There is no standing permission on the
// customer's side and no way to silently upgrade a view-only session into a
// control session — `controlGranted` is written only by the customer's own
// consent call, never by the admin's request.
//
// The row is also the audit trail. It survives the session ending on purpose:
// "who watched whose screen, when, why, for how long, and did they touch
// anything" must be answerable months later.
// ─────────────────────────────────────────────────────────────────────────────

enum RemoteSupportStatus {
  /// Admin has asked. The customer has not answered yet. Dies at expiresAt.
  REQUESTED
  /// Customer said yes. The peer connection is being established.
  CONSENTED
  /// Media is flowing.
  ACTIVE
  /// Finished normally — by either side, or by the heartbeat watchdog.
  ENDED
  /// Customer said no. Terminal: a refusal is never retried into the same row.
  DECLINED
  /// Nobody answered before expiresAt.
  EXPIRED
}

enum RemoteSupportSignalRole {
  ADMIN
  CLIENT
}

model RemoteSupportSession {
  id       String @id @default(cuid())
  tenantId String

  /// The person whose screen this is.
  ///
  /// ⛔ targetUserId and requestedByUserId are deliberately plain columns with
  /// NO foreign key to User, following the AgentEscalation precedent. These
  /// rows are the audit trail, and an audit row that disappears when you delete
  /// the account it accuses is not an audit trail. Resolve the names for
  /// display; never rely on a join existing.
  targetUserId String
  /// The staff member who asked. Never null — an unattributed remote session
  /// is exactly the thing this table exists to make impossible.
  requestedByUserId String

  status RemoteSupportStatus @default(REQUESTED)

  /// ⛔ Two separate booleans, and they are not interchangeable.
  /// `controlRequested` is what the ADMIN asked for; `controlGranted` is what
  /// the CUSTOMER agreed to. The API only ever writes controlGranted from the
  /// consent route, so an admin cannot grant themselves control, and a
  /// view-only session cannot become a control session without asking again.
  controlRequested Boolean @default(false)
  controlGranted   Boolean @default(false)

  /// Why the admin needed in. Shown to the customer in the consent dialog
  /// verbatim — a support request the customer cannot understand is not
  /// informed consent.
  requestReason String

  /// What the desktop app reported about the machine (hostname / OS / app
  /// version), so the audit row says which computer, not just which person.
  deviceLabel String?

  /// A request nobody answers must die rather than sit armed forever.
  expiresAt DateTime

  consentAt  DateTime?
  declinedAt DateTime?
  startedAt  DateTime?
  endedAt    DateTime?
  /// "admin" | "customer" | "watchdog" | "permission_revoked" | "app_closed"
  endedReason String?
  endedBy     String?

  /// Heartbeats. Either side going quiet ends the session — a session that
  /// outlives the window it was displayed in is a screen being watched with
  /// nobody's banner up.
  lastSeenAdminAt  DateTime?
  lastSeenClientAt DateTime?

  /// How many input events were actually injected. Zero on a view-only
  /// session, and the honest answer to "did they touch anything".
  inputEventCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signals RemoteSupportSignal[]

  @@index([tenantId, status])
  @@index([targetUserId, status])
  @@index([requestedByUserId])
  @@index([status, expiresAt])
}

/// WebRTC signalling relay. Deliberately a table and not a socket: setting up
/// a peer connection is a handful of messages over a few seconds, so short
/// polling costs nothing and avoids standing up new realtime infrastructure.
/// Once connected, the screen and every input event ride the peer connection
/// directly and never touch this table.
model RemoteSupportSignal {
  id        String                  @id @default(cuid())
  sessionId String
  fromRole  RemoteSupportSignalRole
  /// "offer" | "answer" | "ice"
  kind      String
  payload   Json
  createdAt DateTime                @default(now())
  /// Stamped when the other side has read it, so each message is delivered
  /// once and the table drains itself.
  consumedAt DateTime?

  session RemoteSupportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, fromRole, consumedAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Desk phones discovered on a customer's own network by the Windows app.
//
// This exists because the MAC address on the PBX record is the single point of
// failure in phone provisioning, and nothing verifies it. A phone whose record
// carries the wrong MAC downloads nothing while the panel looks perfect — the
// Create A Box ext 102 incident, seven weeks of a stale config. These rows are
// the phone's OWN account of itself, so the two can be compared.
// ─────────────────────────────────────────────────────────────────────────────

/// One scan. Kept separately from the phones so "the scan ran and found
/// nothing" is distinguishable from "no scan has ever run" — an empty
/// inventory rendered as a confident "this office has no phones" is the
/// failure mode worth designing out.
model LanDiscoveryRun {
  id       String @id @default(cuid())
  tenantId String

  /// Who ran it and from which machine.
  reportedByUserId String
  deviceLabel      String?
  /// The subnet that was scanned, e.g. "192.168.1.0/24".
  subnet String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// null while running, then "ok" | "partial" | "failed".
  outcome String?
  /// Why a scan failed or returned less than it should have, in plain words.
  note String?

  hostsSeen    Int @default(0)
  phonesFound  Int @default(0)

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phones LanDiscoveredPhone[]

  @@index([tenantId, startedAt])
}

model LanDiscoveredPhone {
  id       String @id @default(cuid())
  tenantId String

  /// Normalised lowercase hex, no separators (e.g. "805e0c4d7e6b"), because
  /// every source formats MACs differently and a mismatch here defeats the
  /// entire point of collecting them.
  macAddress String
  ipAddress  String?
  /// Resolved from the MAC's OUI prefix — "Yealink", "Polycom", "Grandstream".
  vendor     String?
  /// Model and firmware, when the phone's own web interface will say.
  model      String?
  firmware   String?
  hostname   String?
  /// The provisioning server the phone believes it should use. This is the
  /// field that explains a phone which never fetches its config.
  provisioningUrl String?

  /// The most recent scan that saw it, and the first/last times ever seen.
  lastRunId   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastRun LanDiscoveryRun? @relation(fields: [lastRunId], references: [id], onDelete: SetNull)

  /// One row per physical phone per customer. Re-scanning updates in place.
  @@unique([tenantId, macAddress])
  @@index([tenantId, lastSeenAt])
  @@index([tenantId, vendor])
}
