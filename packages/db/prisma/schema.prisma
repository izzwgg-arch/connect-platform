  disposition String?
  pbxCallId   String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pbxCallId])
  @@index([tenantId, startedAt])
}

// Connect-owned CDR — one row per completed canonical call.
// Populated by the telephony service via /internal/cdr-ingest when a call ends.
// This is the authoritative source for dashboard KPI cards and call history.
/// 24/7 call-quality learning store. The worker's hourly aggregation cycle
/// distills every CALL_QUALITY_REPORT into per-hour buckets keyed by the
/// dimensions the adaptive-audio layer learns from (network path, codec,
/// relay vs direct, direction). Raw reports stay in VoiceDiagEvent; this
/// table is the queryable substrate for tuning decisions and degradation
/// alerts — "the system always has the data to learn from" (Izzy 2026-07-29).
model CallQualityHourly {
  id           String   @id @default(cuid())
  hourStart    DateTime
  tenantId     String
  userId       String?
  direction    String? // "inbound" | "outbound"
  audioCodec   String?
  networkType  String?
  usedRelay    Boolean  @default(false)
  calls        Int      @default(0)
  poorCalls    Int      @default(0)
  avgRttMs     Float?
  maxRttMs     Int?
  avgJitterMs  Float?
  avgLossPct   Float?
  maxLossPct   Float?
  avgTxLossPct Float?
  maxTxLossPct Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([hourStart, tenantId, userId, direction, audioCodec, networkType, usedRelay])
  @@index([tenantId, hourStart])
  @@index([hourStart])
}

/// Exactly-once claim ledger for user-visible mobile alerts (voicemail /
/// missed_call / sms_message). EVERY sender — the real-time fast paths in
/// api/worker AND the safety-net reconciler — must claim (type, entityId,
/// userId) here via a unique-constrained insert BEFORE sending. The database
/// arbitrates: whoever inserts first sends; everyone else skips. This ends the
/// era of racing senders and silent double/zero delivery. The reconciler also
/// uses absence of a ledger row to detect facts that were never alerted.
model NotificationLedger {
  id       String   @id @default(cuid())
  /// "voicemail" | "missed_call" | "sms_message"
  type     String
  /// Durable fact id: Voicemail.id / ConnectCdr.linkedId / ConnectChatMessage.id
  entityId String
  /// Recipient user (fanout is per-user for SMS threads)
  userId   String
  tenantId String?
  /// "fastpath:<site>" | "reconciler" — where the claim was made
  source   String
  sentAt   DateTime @default(now())

  @@unique([type, entityId, userId])
  @@index([type, sentAt])
  @@index([sentAt])
}

model ConnectCdr {
  id                     String    @id @default(cuid())
  linkedId               String    @unique // Asterisk Linkedid — canonical dedupe key
  tenantId               String? // Connect Tenant.id when linked; else vpbx:{slug}; null = unassigned
  pbxVitalTenantId       String? // VitalPBX tenant_id (numeric string, e.g. "8")
  pbxTenantCode          String? // Canonical label e.g. "T8"
  tenantResolutionSource String? // audit: how tenantId was chosen
  fromNumber             String?
  fromName               String? // CNAM from AMI CallerIDName (caller's display name)
  fromPrefix             String? // ring-group CID prefix (deduped, e.g. "Estimates") — kept separate from fromName so the UI can render it as a tag
  toNumber               String?
  direction              String // "incoming" | "outgoing" | "internal" | "unknown"
  disposition            String // "answered" | "missed" | "busy" | "failed" | "canceled" | "unknown"
  startedAt              DateTime
  answeredAt             DateTime?
  endedAt                DateTime
  durationSec            Int       @default(0) // wall time: endedAt - startedAt (seconds)
  talkSec                Int       @default(0) // talk time: endedAt - answeredAt (0 if unanswered)
  queueId                String?
  hangupCause            String?
  dcontext               String? // AMI Cdr dcontext — most authoritative direction signal (e.g. "ext-local-gesheft")
  dcontextsSeen          Json? // string[] — all AMI Cdr dcontext values observed for this linkedId
  channelsSeen           Json? // string[] — accumulated channel names for direction evidence
  rawLegCount            Int       @default(1) // how many CDR notifications were received for this linkedId (channel-leg count)
  isForwarded            Boolean   @default(false) // true for :out rows — inbound call automatically forwarded to an external number (find-me/follow-me)
  recordingPath          String? // deterministic path "YYYY/MM/DD/<linkedId>.wav" computed at ingest; null when call is not recorded
  /// Set once the PBX has CONFIRMED the recording file does not exist.
  ///
  /// recordingPath is captured from the AMI VarSet of __REC_FILENAME /
  /// MIXMONITOR_FILENAME — a variable VitalPBX sets on calls it then does NOT
  /// record (it is the name the file WOULD have had). So a non-null
  /// recordingPath proves intent, never existence: on 2026-08-11, Trust
  /// Bookkeeping showed 69 play buttons for the day against 38 real files.
  /// Stamped only after the stream/download path 404s AND the VitalPBX-CDR
  /// recovery lookup also comes back empty, so a transient PBX error can never
  /// set it. Rows carrying it are excluded from recordingAvailable, which is
  /// what removes the dead play/download buttons.
  recordingMissingAt     DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId, startedAt]) // per-tenant KPI queries
  @@index([startedAt]) // global aggregate queries
  @@index([tenantId, direction, startedAt]) // typed per-tenant KPI queries
}

/// Extra addresses an admin has added to receive an extension's voicemail email.
/// The address the PBX already uses lives on Extension.pbxUserEmail and is always
/// included first - this table is purely ADDITIONAL recipients.
model VoicemailEmailRecipient {
  id          String   @id @default(cuid())
  tenantId    String
  extensionId String
  email       String
  createdById String?
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extension Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([extensionId, email])
  @@index([tenantId])
}

model Voicemail {
  id             String    @id @default(cuid())
  tenantId       String? // Connect Tenant.id; null = unresolved
  pbxMessageId   String    @unique // stable dedup key: "{pbxTenantId}|{ext}|{origtime}|{callerDigits10}"
  extension      String // mailbox extension number (e.g. "104")
  pbxExtensionId String? // VitalPBX resource ID for this extension
  callerNumber   String?
  callerName     String?
  durationSec    Int       @default(0)
  folder         String    @default("inbox") // normalised: "inbox" | "old" | "urgent"
  pbxFolder      String? // raw PBX folder (e.g. "INBOX", "Old", "Urgent")
  pbxMsgNum      String? // PBX message file basename (e.g. "msg0007")
  pbxRecfile     String? // VitalPBX-relative playback path (e.g. "/static/<tok>/voicemail/<tenant>/<ext>/INBOX/msg0007.wav") — token-authenticated, no app-key needed
  listened       Boolean   @default(false)
  receivedAt     DateTime
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ── Team-shared note (single editable note per voicemail) ──────────────
  note                String? // shared note body; null/empty = no note
  noteUpdatedAt       DateTime?
  noteUpdatedByUserId String? // who last edited the shared note

  // ── Callback reminder (timed, dismissible alert to the setter) ─────────
  callbackReminderAt      DateTime? // when to alert; null = no reminder
  callbackReminderSetById String? // user who set it — the ONLY one alerted
  callbackReminderLabel   String? // optional short label shown in the alert
  callbackReminderFiredAt DateTime? // when the due-alert was delivered
  callbackReminderAckAt   DateTime? // when the setter dismissed the alert

  // ── Auto-transcription (agent): Yiddish → ivrit engine, English → GPT ──
  transcript         String? // transcript text in the spoken language
  transcriptLanguage String? // "yi" | "en" | "yi-en"
  transcriptEngine   String? // internal engine tag (never shown on frontend)
  transcribedAt      DateTime?
  transcriptError    String? // last failure reason; null when ok

  // ── Voicemail-to-email (agent sender) ─────────────────────────────────
  // emailedAt is stamped exactly once per voicemail after the sender has
  // PROCESSED it (sent, skipped, or failed) so it is never re-sent. emailError
  // holds the skip/fail reason (null when delivered). The sender only ever
  // considers messages with emailedAt == null AND a recent receivedAt, so the
  // historical backlog can never be emailed.
  emailedAt  DateTime?
  emailError String?
  /// Why no email was produced: disabled | no_recording | too_short | no_recipient.
  /// null = an email was queued. Lets the watchdog tell a deliberate skip from a
  /// failure without guessing, which is what stops the alarm crying wolf.
  emailSkipReason String?

  // ── Local audio copy + audio-gone verdict ──────────────────────────────
  // localAudioPath: filename inside VOICEMAIL_AUDIO_STORAGE_DIR ("<vmId>.<ext>").
  // Voicemail audio is immutable once recorded, so after the first successful
  // PBX fetch the bytes are served from Connect's own disk forever — the PBX
  // is never asked twice for the same message.
  localAudioPath String?
  // audioGoneAt: a SUCCESSFUL, pagination-complete spool scan proved this
  // message's origtime is no longer in the mailbox. Permanent by nature
  // (deleted spool audio never comes back); clears only by manual DB update.
  // Helper timeouts/errors must NEVER stamp this — only a completed scan may.
  audioGoneAt DateTime?

  @@index([tenantId])
  @@index([extension])
  @@index([receivedAt])
  @@index([tenantId, extension, receivedAt])
  // Scheduler scan: due, not-yet-fired reminders.
  @@index([callbackReminderAt, callbackReminderFiredAt])
}

// Admin-configured rules that map DID or extension patterns to VitalPBX tenant slugs.
// Populated via the /admin/cdr/tenant-rules API. Used by CDR ingest to assign tenantId
// when it cannot be resolved from AMI events.
//
// matchType:
//   "did"              — exact match on toNumber (e.g., "8452449666")
//   "from_did"         — exact match on fromNumber (for outgoing calls from a DID)
//   "extension_prefix" — fromNumber starts with this prefix (e.g., "10" matches 100-109)
//
// tenantSlug: VitalPBX tenant name field (e.g., "a_plus_center") — stored without vpbx: prefix.
//             The tenantId written to ConnectCdr will be "vpbx:{tenantSlug}".
model CdrTenantRule {
  id          String   @id @default(cuid())
  matchType   String // "did" | "from_did" | "extension_prefix"
  matchValue  String // the phone number, DID, or prefix
  tenantSlug  String // VitalPBX tenant name (without vpbx: prefix)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([matchType, matchValue])
  @@index([matchType, matchValue])
}

model PbxJob {
  id            String       @id @default(cuid())
  tenantId      String
  pbxInstanceId String?
  type          String
  payload       Json
  status        PbxJobStatus @default(QUEUED)
  attempts      Int          @default(0)
  nextRunAt     DateTime     @default(now())
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pbxInstance   PbxInstance? @relation(fields: [pbxInstanceId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt])
  @@index([tenantId, createdAt])
}

model MobileDevice {
  id                    String               @id @default(cuid())
  tenantId              String
  userId                String
  extensionId           String?
  platform              MobilePlatform
  /// ⛔ NULLABLE ON PURPOSE (2026-08-06). This was `String @unique` (required),
  /// which made the FAST push channel HOSTAGE TO THE SLOW ONE: the only way a
  /// phone can hand us its native FCM token is inside
  /// `POST /mobile/devices/register`, and that call could not be made at all
  /// without an Expo token. `getExpoToken()` in the app has an explicit
  /// "Expo token failed (raw FCM available)" branch — i.e. a handset holding a
  /// perfectly good FCM token was unable to report it, and stayed on the
  /// deprioritized Expo relay forever. Census 2026-08-06: 8 of 16 active
  /// Android devices had no token on file.
  /// Postgres treats NULLs as distinct, so @unique still prevents two devices
  /// sharing one real Expo token. Rows with no Expo token are keyed by
  /// @@unique([userId, deviceId]) below.
  expoPushToken         String?              @unique
  voipPushToken         String?
  /// Native APNs device token (iOS, alert environment) — reported by the app on
  /// register. Enables direct APNs alert pushes for user notifications
  /// (voicemail / missed call / chat / SMS), bypassing the Expo relay whose
  /// stored push key went invalid 2026-07-30 (InvalidProviderToken 403 on every
  /// iOS alert). Null on Android and on older iOS builds (those fall back to Expo).
  apnsAlertToken        String?
  /// Native FCM registration token (Android) — enables direct high-priority
  /// FCM call wakes, bypassing the Expo relay. Null until the app reports it.
  nativeFcmToken        String?
  /// Last time this device acknowledged a call-wake push (DEVICE_* stage via
  /// /mobile/wake/event). Sent-but-never-acked is the wake-health failure signal.
  lastWakeAckAt         DateTime?
  deviceId              String?
  appVersion            String?
  deviceName            String?
  // Call-wake diagnostics — populated by /mobile/devices/register on every
  // app start so backend can correlate S24 vs S25 vs OnePlus vs Pixel etc.
  manufacturer          String?
  model                 String?
  osVersion             String?
  // Updated by sendPushToUserDevices on every push. Lets the admin /mobile
  // diagnostics surface confirm "yes the push was sent at <ts> and Expo
  // accepted it" or "Expo rejected it with reason X".
  lastPushSentAt        DateTime?
  lastPushType          String?
  lastPushStatus        String?
  lastPushError         String?
  // Runtime-permission snapshot reported by the mobile app on every
  // /mobile/devices/register call. Used by /admin/call-wake-diagnostics
  // to flag devices that are missing RECORD_AUDIO (answer-then-disconnect)
  // or POST_NOTIFICATIONS (no heads-up ringer / lock-screen full-screen
  // intent) without needing the device in hand.
  permRecordAudio       Boolean?
  permNotifications     Boolean?
  permissionsReportedAt DateTime?
  // SipKeepAliveService FGS snapshot reported by the mobile app on every
  // /mobile/devices/register call. Stored as a single JSON blob because the
  // schema is loose (Android-only, may grow as we add more diagnostic
  // fields) and per-row at most ~250 bytes. Powers the FGS health card on
  // /admin/call-wake-diagnostics — primary signal for "calls don't ring on
  // backgrounded S25 / Android 15" (PHONE_CALL FGS rejected by One UI 7).
  keepAliveSnapshot     Json?
  keepAliveReportedAt   DateTime?
  // Per-device remote feature flags, returned verbatim to the app by
  // /mobile/devices/register. Currently: { standingRegistration?: boolean }.
  // null/absent key = flag off. This is the remote kill-switch for the
  // standing-SIP-registration mode: flip the key off and the device reverts
  // to legacy behavior on its next register (no rebuild required).
  featureFlags          Json?
  active                Boolean              @default(true)
  deactivatedAt         DateTime?
  lastSeenAt            DateTime             @default(now())
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  extension             Extension?           @relation(fields: [extensionId], references: [id], onDelete: SetNull)
  acceptedInvites       CallInvite[]         @relation("CallInviteAcceptedByDevice")
  voiceClientSessions   VoiceClientSession[]
  callWakeEvents        CallWakeEvent[]      @relation("CallWakeEventByDevice")

  /// Natural key for a device that has NO Expo token (see `expoPushToken`).
  /// `deviceId` is per-install and stable (SecureStore), so this identifies the
  /// same handset across registers without needing a relay token. Verified safe
  /// against production before adding: 94 rows, 0 duplicate (userId, deviceId)
  /// pairs, 1 null deviceId — and Postgres allows repeated NULLs here.
  @@unique([userId, deviceId])
  @@index([tenantId, userId])
  @@index([tenantId, platform])
  @@index([tenantId, userId, active])
  @@index([tenantId, lastPushSentAt])
  @@index([extensionId])
}

