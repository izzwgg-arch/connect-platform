  cdrCursors            PbxCdrCursor[]
  pbxJobs               PbxJob[]
  webhookRegistration   PbxWebhookRegistration?
  tenantDirectory       PbxTenantDirectory[]
  tenantInboundDids     PbxTenantInboundDid[]
  didRouteMappings      DidRouteMapping[]
  mohClasses            PbxMohClass[]
}

// Cached VitalPBX tenant rows for deterministic mapping (T8 / numeric id / slug -> Connect tenant).
model PbxTenantDirectory {
  id            String      @id @default(cuid())
  pbxInstanceId String
  vitalTenantId String
  tenantSlug    String
  tenantCode    String
  displayName   String?
  syncedAt      DateTime    @default(now())
  pbxInstance   PbxInstance @relation(fields: [pbxInstanceId], references: [id], onDelete: Cascade)

  @@unique([pbxInstanceId, vitalTenantId])
  @@index([pbxInstanceId, tenantCode])
  @@index([pbxInstanceId, tenantSlug])
}

