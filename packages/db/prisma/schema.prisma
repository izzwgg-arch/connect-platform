/// One row per user who has started (or finished) MFA enrolment.
/// `enabledAt` null = a setup was started but the first code was never
/// confirmed; such a row is inert at login. The TOTP secret is stored as the
/// AES-256-GCM / CREDENTIALS_MASTER_KEY envelope (`@connect/security`
/// encryptJson), never in the clear. `lastUsedCounter` is the RFC 6238 time-step
/// of the last ACCEPTED code — the replay guard.
model UserMfa {
  id                  String                @id @default(cuid())
  userId              String                @unique
  totpSecretEncrypted String
  enabledAt           DateTime?
  lastUsedCounter     Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes       UserMfaRecoveryCode[]
}

/// Single-use recovery codes, bcrypt-hashed. `usedAt` set = spent.
model UserMfaRecoveryCode {
  id        String    @id @default(cuid())
  userMfaId String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userMfa   UserMfa   @relation(fields: [userMfaId], references: [id], onDelete: Cascade)

  @@index([userMfaId, usedAt])
}

/// A one-time sign-in code (per-tenant 2FA-by-code, 2026-08-19). The code is
/// stored ONLY as a SHA-256 hash; the clear text exists in the text/email and
/// nowhere else. `preAuthJti` binds the code to the pre-auth token the login
/// answered with, so a code can only be spent by the login that requested it.
/// `consumedAt` set = spent. `attempts` counts wrong guesses (max 5).
model LoginOtpChallenge {
  id                String    @id @default(cuid())
  userId            String
  tenantId          String
  preAuthJti        String
  channel           String
  destinationMasked String
  codeHash          String
  attempts          Int       @default(0)
  sendCount         Int       @default(1)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([preAuthJti])
}

/// "Remember this device" for the sign-in code. The token the browser keeps is
/// random and stored ONLY as a SHA-256 hash; presenting it at login skips the
/// code until `expiresAt` (90 days) or revocation. Bound to ONE user — it can
/// never skip the code for anyone else.
model TrustedLoginDevice {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Loopcom Meetings (2026-08-20): one row per meeting link. The `code` is the
/// whole credential a guest presents — unguessable, per-meeting, never expires
/// on a clock (pay-link precedent). The LiveKit room name is derived from `id`,
/// so a code can never collide with a room that outlived its row.
/// `createdByUserId` is a plain column on purpose (no FK): deleting a user must
/// never take a tenant's meeting history down with it, and the tenant relation
/// below already cascades the rows away when the COMPANY goes.
model VideoMeeting {
  id              String    @id @default(cuid())
  code            String    @unique
  tenantId        String
  createdByUserId String
  title           String
  locked          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  endedAt         DateTime?
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([createdByUserId, createdAt])
}

