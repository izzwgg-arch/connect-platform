}

model PaymentTransaction {
  id                       String                          @id @default(cuid())
  tenantId                 String
  invoiceId                String?
  paymentMethodId          String?
  billingChargeOperationId String?
  amountCents              Int
  currency                 String                          @default("USD")
  status                   BillingPaymentTransactionStatus @default(PENDING)
  processor                BillingPaymentMethodProcessor   @default(SOLA)
  processorTransactionId   String?
  /// xRefNum returned by the processor for the refund (cc:refund / cc:credit). Set when a refund is confirmed at the processor.
  processorRefundRef       String?
  responseCode             String?
  responseMessage          String?
  rawResponseSafeJson      Json?
  idempotencyKey           String?                         @unique
  /// "GATEWAY" = Cardknox/Sola | "MANUAL" = posted by operator for external payment
  source                   String?
  /// External payment method when source = "MANUAL"
  externalMethod           ExternalPaymentMethod?
  /// Check number, Zelle ref, QuickPay confirmation, etc.
  externalReference        String?
  /// Name of the person/entity who made the external payment
  payerName                String?
  /// Actual date the payment was made (may differ from createdAt for back-dated entries)
  paymentDate              DateTime?
  /// Operator notes on the external payment
  externalNotes            String?
  /// userId of the operator who posted this transaction (null = gateway-automated)
  createdByUserId          String?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  tenant                   Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice                  BillingInvoice?                 @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentMethod            PaymentMethod?                  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  billingChargeOperation   BillingChargeOperation?         @relation(fields: [billingChargeOperationId], references: [id], onDelete: SetNull)

  @@unique([processor, processorTransactionId])
  @@index([tenantId, createdAt])
  @@index([tenantId, source])
  @@index([invoiceId, createdAt])
  @@index([billingChargeOperationId])
  @@index([processor, processorTransactionId])
  @@index([processor, processorRefundRef])
}

