model PaymentMethod {
  id                        String                            @id @default(cuid())
  tenantId                  String
  processor                 BillingPaymentMethodProcessor     @default(SOLA)
  tokenEncrypted            String
  tokenKeyId                String                            @default("v1")
  brand                     String?
  last4                     String?
  expMonth                  String?
  expYear                   String?
  cardholderName            String?
  billingZip                String?
  isDefault                 Boolean                           @default(false)
  active                    Boolean                           @default(true)
  isImported                Boolean                           @default(false)
  importedAt                DateTime?
