  lastSeenAt      DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  pbxInstance     PbxInstance @relation(fields: [pbxInstanceId], references: [id], onDelete: Cascade)

  @@unique([pbxInstanceId, e164])
  @@index([pbxInstanceId, vitalTenantId])
  @@index([e164])
  @@index([connectTenantId])
  @@index([pbxInstanceId, active])
}

model PbxWebhookRegistration {
