/// Read-only mirror of Sola/Cardknox recurring schedules for operator mapping (no raw PAN/token).
model BillingSolaExternalScheduleLink {
  id                       String                        @id @default(cuid())
  tenantId                 String?
  suggestedTenantId        String?
  solaCustomerId           String
  solaPaymentMethodId      String?
  solaScheduleId           String                        @unique
  customerName             String?
  customerEmail            String?
  companyName              String?
  maskedCard               String?
  brand                    String?
  last4                    String?
  expMonth                 String?
  expYear                  String?
  amountCents              Int?
  intervalType             String?
  intervalCount            Int?
  nextRunAt                DateTime?
  lastRunAt                DateTime?
  lastTransactionStatus    String?
  isActive                 Boolean                       @default(false)
  mappingStatus            SolaScheduleLinkMappingStatus @default(UNMAPPED)
  matchConfidence          String?
  matchReason              String?
  rawSafeJson              Json?
  mappedByUserId           String?
  mappedAt                 DateTime?
  lastSyncedAt             DateTime?
  cutoverStatus            String?
  linkedPaymentMethodId    String?
  tokenLinkedAt            DateTime?
  cutoverAt                DateTime?
  cutoverByUserId          String?
  disabledSolaAt           DateTime?
  disableAttemptedAt       DateTime?
  disableError             String?
  connectAutopayEnabledAt  DateTime?
  /// First UTC timestamp at which Connect is allowed to charge this tenant.
  /// Set during takeOverBillingFromSola to the start of the NEXT billing period
  /// (i.e. the period after Sola already covered with its last charge).
  /// Worker must NOT charge before this time.
  nextConnectChargeAt      DateTime?
  /// NextScheduledRunTime from Sola at the time of cutover — used for forensics
  /// and to compute nextConnectChargeAt when billingDayOfMonth is unavailable.
  sourceSolaNextChargeDate DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  tenant                   Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  mappedByUser             User?                         @relation("SolaScheduleMappedBy", fields: [mappedByUserId], references: [id], onDelete: SetNull)
  linkedPaymentMethod      PaymentMethod?                @relation("LinkedPaymentMethod", fields: [linkedPaymentMethodId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([suggestedTenantId])
  @@index([mappingStatus])
  @@index([solaCustomerId])
  @@index([solaPaymentMethodId])
  @@index([isActive])
  @@index([cutoverStatus])
  @@index([linkedPaymentMethodId])
}

