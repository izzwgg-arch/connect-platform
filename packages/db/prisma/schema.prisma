/// Recurring billing profile within a tenant — one profile per end-client/sub-account.
/// Each profile generates its own invoice on the tenant's autopay schedule,
/// charged to its own payment method. Designed for MSP/reseller tenants.
model TenantBillingProfile {
  id                 String           @id @default(cuid())
  tenantId           String
  /// Sub-client or cost-center name displayed on the invoice.
  label              String
  paymentMethodId    String?
  autoBillingEnabled Boolean          @default(false)
  billingEmail       String?
  notes              String?
  /// Serialized line items: array of { type, description, quantity, unitPriceCents }.
  lineItemsJson      Json?
  createdByUserId    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentMethod      PaymentMethod?   @relation("BillingProfilePaymentMethod", fields: [paymentMethodId], references: [id], onDelete: SetNull)
  invoices           BillingInvoice[]

  @@index([tenantId])
  @@index([tenantId, autoBillingEnabled])
}

model TenantBillingSettings {
  id                              String         @id @default(cuid())
  tenantId                        String         @unique
  billingPlanId                   String?
  extensionPriceCents             Int            @default(3000)
  additionalPhoneNumberPriceCents Int            @default(1000)
  smsPriceCents                   Int            @default(1000)
  firstPhoneNumberFree            Boolean        @default(true)
  smsBillingEnabled               Boolean        @default(false)
  taxEnabled                      Boolean        @default(false)
  taxProfileId                    String?
  autoBillingEnabled              Boolean        @default(false)
  billingDayOfMonth               Int            @default(1)
  paymentTermsDays                Int            @default(15)
  defaultPaymentMethodId          String?
  billingEmail                    String?
  billingAddress                  Json?
  serviceAddress                  Json?
  creditsCents                    Int            @default(0)
  discountPercent                 Decimal        @default(0) @db.Decimal(7, 6)
  metadata                        Json?
  /// Display name on invoices/emails (falls back to tenant name).
  invoiceCompanyName              String?
  /// HTTPS URL for logo in HTML emails only (PDF uses text header — no remote image fetch).
  invoiceLogoUrl                  String?
  invoiceSupportEmail             String?
  invoiceSupportPhone             String?
  /// Plain text, length-capped in API (invoice PDF + email footers).
  invoiceFooterNote               String?
  invoicePaymentInstructions      String?
  /// Scheduled plan change: new plan to apply at the start of the next billing period.
  nextBillingPlanId               String?
  /// UTC midnight on the first day of the billing period when nextBillingPlanId becomes effective.
  nextBillingPlanEffectiveAt      DateTime?
  /// Per-DID monthly price for PBX-synced inbound numbers (PbxTenantInboundDid).
  /// Default 0 = all PBX DIDs appear on invoices at no charge.
  /// Set > 0 to bill per synced DID (e.g. 100 = $1.00/month each).
