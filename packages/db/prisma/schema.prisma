  pbxLink                  PbxExtensionLink?
  contacts                 Contact[]
  callInvites              CallInvite[]
  callWakeEvents           CallWakeEvent[]
  tenantSmsNumbersAssigned TenantSmsNumber[]        @relation("TenantSmsNumberAssignExtension")
  connectChatParticipants  ConnectChatParticipant[] @relation("ConnectChatParticipantExtension")
  mobileDevices            MobileDevice[]
  userSipAccounts          UserSipAccount[]

  voicemailEmailRecipients VoicemailEmailRecipient[]

  @@unique([tenantId, extNumber])
  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
}

model PbxInstance {
