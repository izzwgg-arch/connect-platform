model WhatsAppAccount {
  id                        String               @id @default(cuid())
  tenantId                  String
  provider                  WhatsAppProviderType
  phoneE164                 String
  phoneNumberId             String?
  wabaId                    String?
  messagingServiceSid       String?
  displayName               String?
  profilePhotoUrl           String?
  aboutText                 String?
  verificationStatus        String?
  lifecycleStatus           String?
  verificationMethod        String?
  verifiedAt                DateTime?
  lastVerificationAttemptAt DateTime?
  lastProviderError         String?
  webhookStatus             String?
  lastWebhookAt             DateTime?
  ownershipKind             String               @default("TENANT")
  ownerUserId               String?
  providerConfigId          String?
  /// PLATFORM = under Connect's WABA (no per-account token — the platform token
  /// signs the send). OWN = the customer's own WABA, which brings its own token.
  /// ⛔ Both modes must resolve credentials through ONE resolver. Two credential
  /// paths is the exact shape that shipped the two IVR publish paths and the two
  /// welcome-email paths half-fixed.
  hostingMode               WhatsAppHostingMode  @default(PLATFORM)
  /// Set only when hostingMode = OWN. Encrypted with CREDENTIALS_MASTER_KEY, the
  /// same machinery as WhatsAppProviderConfig.credentialsEncrypted.
  accessTokenEncrypted      String?
  settings                  Json?
  isEnabled                 Boolean              @default(true)
  lastSyncedAt              DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerUser           User?                   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  providerConfig      WhatsAppProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  whatsAppTemplates   WhatsAppTemplate[]
  whatsAppUsageEvents WhatsAppUsageEvent[]

  @@unique([tenantId, provider, phoneE164])
  @@index([tenantId, provider, phoneNumberId])
  @@index([tenantId, isEnabled])
}

