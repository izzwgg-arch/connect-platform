{
  "name": "@connect/agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo lint-agent",
    "test": "node --experimental-test-module-mocks --import tsx --test \"src/**/*.test.ts\"",
    "certify": "tsx src/certification/run.ts"
  },
  "dependencies": {
    "@connect/db": "workspace:*",
    "@connect/shared": "workspace:*",
    "@connect/security": "workspace:*",
    "@anthropic-ai/sdk": "^0.60.0",
    "fastify": "^5.6.0",
    "@fastify/rate-limit": "^10.3.0",
    "nodemailer": "^8.0.7",
    "openai": "^6.39.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
