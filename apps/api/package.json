{
  "name": "@connect/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "pbx:diagnose": "tsx scripts/run-pbx-diagnostics.ts",
    "pbx:enable-instances": "tsx scripts/enable-pbx-instances.ts",
    "pbx:diagnose-by-name": "tsx scripts/pbx-diagnose-by-tenant-name.ts",
    "pbx:link-tenant": "tsx scripts/link-tenant-to-pbx.ts",
    "pbx:link-all-tenants": "tsx scripts/link-all-tenants-to-pbx.ts",
    "pbx:set-ombu-mysql": "tsx scripts/set-ombu-mysql-and-sync-dids.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "echo lint-api",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test \"src/*.test.ts\" \"src/agentProvisioning/*.test.ts\" \"src/meetings/*.test.ts\" \"src/remoteSupport/*.test.ts\" \"src/mfa/*.test.ts\" \"src/signalwire/*.test.ts\" \"src/voice/*.test.ts\" \"src/voicemail/*.test.ts\" \"src/crm/*.test.ts\" \"src/onboarding/*.test.ts\" \"src/pbxConsole/*.test.ts\" \"src/pbx/*.test.ts\" \"src/sms/*.test.ts\" \"src/deskPhoneSetup/*.test.ts\" \"src/billing/billingEmailLifecycle.test.ts\" \"src/billing/receiptReconciliation.test.ts\" \"src/billing/externalPayment.test.ts\" \"src/billing/billingEmailTemplates.test.ts\" \"src/billing/serviceInterruption/*.test.ts\" \"src/billing/billingEmailAttachments.test.ts\" \"src/billing/billingPdf.test.ts\" \"src/billing/billingPdfLogo.test.ts\" \"src/billing/billingReceiptPdfContent.test.ts\" \"src/billing/paymentTransactionAlerts.test.ts\"",
    "test:billing": "node --experimental-test-module-mocks --import tsx --test \"src/billing/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@connect/db": "workspace:*",
    "@connect/integrations": "workspace:*",
    "@connect/security": "workspace:*",
    "@connect/shared": "workspace:*",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@google-cloud/speech": "^7.3.2",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vertexai": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.0",
    "city-timezones": "^1.3.4",
    "fastify": "^5.6.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.8.0",
    "mammoth": "^1.12.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^8.0.7",
    "openai": "^6.39.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
