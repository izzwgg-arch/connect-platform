<resources>
  <!-- The pre-JS window color (drawable/splashscreen.xml). Follows the SYSTEM
       theme: light here, brand navy in values-night. The in-app splash then
       follows the IN-APP theme (Izzy 2026-08-23) — the system theme is the
       best native-side guess since the saved in-app theme isn't readable
       before JS loads. -->
  <color name="splashscreen_background">#f2f7fd</color>
  <color name="iconBackground">#FFFFFF</color>
  <color name="colorPrimary">#023c69</color>
  <color name="colorPrimaryDark">#040810</color>
  <color name="activityBackground">#040810</color>
  <!-- Tint Android applies to the white notification_icon silhouette (shade header
       accent). Brand accent per the Signal Core kit — was #1d4ed8, the pre-rebrand
       Connect blue, until 2026-08-22. -->
  <color name="notification_icon_color">#22A8FF</color>
</resources>