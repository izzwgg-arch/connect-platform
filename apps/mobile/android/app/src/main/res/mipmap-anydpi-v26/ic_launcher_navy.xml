<?xml version="1.0" encoding="utf-8"?>
<!-- Navy 2A adaptive icon — the dark-mode launcher variant, shown when the
     .LauncherNavy activity-alias is enabled (in-app theme = dark). The default
     (light-mode) icon is Blue 2B on the .LauncherBlue alias / ic_launcher. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@mipmap/ic_launcher_navy_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_navy_foreground"/>
</adaptive-icon>
