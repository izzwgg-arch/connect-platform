<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- ══════════════════ LOOPCOM DRIVER MANIFEST ══════════════════
       Used ONLY when CONNECT_DRIVER_APP=1 (see android/app/build.gradle).
       The driver app is the delivery run and nothing else: location while on a
       run, camera for scanning package labels and proof photos, notifications
       for the tracking foreground service. Deliberately ABSENT versus the
       phone app's manifest: RECORD_AUDIO, telecom/SIP services, the FCM
       message service, contacts, boot receivers.
       ⛔ Keep the launcher aliases in step with src/main — ThemeContext flips
       .LauncherBlue/.LauncherNavy by component name on every theme change and
       at boot; if the aliases are missing the flip rejects on every launch. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <!-- Run tracking: foreground-service location ONLY (decision 6 — no
       background-location permission; tracking lives behind a visible
       persistent notification for the length of the run). -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
  <!-- Library manifests (react-native-webrtc et al.) merge their own
       permissions in; strip everything phone-shaped so the DRIVER apk never
       requests a microphone or telephony surface. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove"/>
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>
  <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove"/>
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_CONTACTS" tools:node="remove"/>
  <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" tools:node="remove"/>
  <queries>
    <!-- Navigation handoff: let the app detect Waze / Google Maps installs. -->
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <data android:scheme="waze"/>
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <data android:scheme="google.navigation"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="Loopcom Driver" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:theme="@style/AppTheme">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="NEVER"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <!-- Phone-app services that must never exist in the driver apk. The
         library/main manifests are not merged here (this file REPLACES
         src/main's), but expo/callkeep library manifests still merge, so keep
         the telecom service removed explicitly. -->
    <service android:name="io.wazo.callkeep.VoiceConnectionService" tools:node="remove"/>
    <service android:name="expo.modules.notifications.service.ExpoFirebaseMessagingService" tools:node="remove"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="loopcom-driver"/>
      </intent-filter>
    </activity>
    <activity-alias android:name=".LauncherBlue" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true" android:label="Loopcom Driver" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity-alias android:name=".LauncherNavy" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="Loopcom Driver" android:icon="@mipmap/ic_launcher_navy" android:roundIcon="@mipmap/ic_launcher_navy_round">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity-alias>
    <activity android:name="com.facebook.react.devsupport.DevSettingsActivity" android:exported="false"/>
  </application>
</manifest>
