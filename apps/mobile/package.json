{
  "name": "@connect/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:dev-client:usb": "expo start --dev-client --localhost --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:dev": "eas build --platform android --profile dev",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:dev": "eas build --platform ios --profile dev",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "typecheck": "tsc --noEmit",
    "lint": "echo lint-mobile",
    "test:caller-identity": "tsx --test src/calls/callerIdentity.test.ts",
    "test:notification-routing": "tsx --test src/notifications/notificationRouting.test.ts",
    "test:call-origin": "tsx --test src/navigation/callOrigin.test.ts",
    "test:call-history-merge": "tsx --test src/storage/callHistory.merge.test.ts",
    "test:vm-greeting": "tsx src/voicemail/vmGreetingInviteUtils.test.ts",
    "test:voicemail-pagination": "tsx src/api/voicemailPagination.test.ts",
    "test:voicemail-scope": "tsx src/api/voicemailScope.test.ts",
    "test:voicemail-client-scope": "tsx src/api/voicemailClientScope.test.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@connect/shared": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.100.6",
    "expo": "~54.0.36",
    "expo-av": "~16.0.8",
    "expo-battery": "~10.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-camera": "^17.0.10",
    "expo-clipboard": "^8.0.8",
    "expo-constants": "^18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-dev-client": "^6.0.21",
    "expo-device": "^8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "^15.0.8",
    "expo-image-picker": "^17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-location": "^19.0.8",
    "expo-notifications": "^0.32.17",
    "expo-secure-store": "^15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "^3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.19",
    "jssip": "^3.10.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-callkeep": "^4.3.13",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-incall-manager": "^4.0.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-voip-push-notification": "^3.3.3",
    "react-native-webrtc": "^124.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@expo/ngrok": "4.1.3",
    "@types/node": "^25.5.2",
    "@types/node-forge": "^1.3.14",
    "@types/react": "~19.1.17",
    "@types/react-native": "^0.73.0",
    "node-forge": "^1.4.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
