{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "types": ["node"],
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  // Tests are run straight from source with tsx; compiling them would ship test
  // files inside the installer, since electron-builder packages all of dist/**.
  "exclude": ["src/**/*.test.ts"]
}
