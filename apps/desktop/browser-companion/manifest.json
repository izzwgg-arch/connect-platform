{
  "manifest_version": 3,
  "name": "Loopcom Browser Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Let Loopcom Coworker work in explicitly assigned Chrome tabs. Pause or stop at any time.",
  "key": "",
  "permissions": ["storage", "alarms", "scripting", "downloads", "activeTab"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "Loopcom Coworker", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
