{
  "name": "@connect/desktop",
  "version": "0.1.10",
  "private": true,
  "description": "Loopcom desktop phone",
  "author": "Loopcom LLC",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/phoneSetup/*.test.ts",
    "verify:icon": "node --import tsx scripts/verify-built-icon.ts",
    "dist": "pnpm build && electron-builder --win && pnpm verify:icon"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
