{
  "name": "@connect/desktop-support",
  "version": "0.0.2",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/remoteSupport/inputInjector.test.ts src/remoteSupport/lanScan.test.ts",
    "dist": "pnpm build && electron-builder --win"
  },
  "build": {
    "appId": "com.connectcommunications.supporttools",
    "productName": "Loopcom Support",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "LoopcomSupport-Setup-${version}.${ext}"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
