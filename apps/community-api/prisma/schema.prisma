  @@index([ownerId, dueAt, doneAt])
  @@index([dueAt, notifiedAt])
}

// ───────────────────────────── Notifications ─────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  personId    String
  /// Class key, e.g. connection.request, message.new, rfq.quote — see notifications/classes.ts
  kind        String
  title       String
  body        String?
  href        String?
  actorId     String?
  objectType  String?
  objectId    String?
  /// Batching: reactions/follows collapse into one row keyed by group.
  groupKey    String?
  count       Int       @default(1)
  readAt      DateTime?
  pushedAt    DateTime?
  emailedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, readAt, createdAt])
  @@index([personId, groupKey])
}

model NotificationPref {
  personId String
  kind     String
  inApp    Boolean @default(true)
  push     Boolean @default(true)
  email    Boolean @default(false)
  sms      Boolean @default(false)
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([personId, kind])
}

model DeviceToken {
  id        String   @id @default(cuid())
  personId  String
  platform  String
  token     String   @unique
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

// ───────────────────────────── Search ─────────────────────────────

model SavedSearch {
  id        String   @id @default(cuid())
  personId  String
  query     String
  filters   Json?
  alerts    Boolean  @default(false)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
}

model RecentSearch {
  id        String   @id @default(cuid())
  personId  String
  query     String
  createdAt DateTime @default(now())

  @@index([personId, createdAt])
}

// ───────────────────────────── Media ─────────────────────────────

enum AssetStatus {
  UPLOADING
  PROCESSING
  READY
  REJECTED
}

model MediaAsset {
  id          String      @id @default(cuid())
  ownerId     String
  kind        String
  mime        String
  bytes       Int
  width       Int?
  height      Int?
  durationSec Int?
  storageKey  String
  variants    Json?
  sha256      String?
  status      AssetStatus @default(UPLOADING)
  isPrivate   Boolean     @default(false)
  scanResult  String?
  originalName String?
  createdAt   DateTime    @default(now())
  owner       Person      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postMedia   PostMedia[]

  @@index([ownerId, createdAt])
}

// ───────────────────────────── Analytics, experiments, flags ─────────────────────────────

model AnalyticsEvent {
  id               String   @id @default(cuid())
  personId         String?
  sessionId        String?
  event            String
  objectType       String?
  objectId         String?
  client           String?
  appVersion       String?
  surface          String?
  position         Int?
  recommendationId String?
  experimentId     String?
  props            Json?
  occurredAt       DateTime @default(now())
  person           Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

