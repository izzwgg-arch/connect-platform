  personId     String
  variant      String
  assignedAt   DateTime   @default(now())
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([experimentId, personId])
}

// ───────────────────────────── Moderation & audit ─────────────────────────────

enum ReportReason {
  SPAM
  SCAM
  HARASSMENT
  IMPERSONATION
  PHISHING
  MALWARE
  FAKE_JOB
  FAKE_COMPANY
  FAKE_REVIEW
  BOT
  MASS_SOLICITATION
  OTHER
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       ReportReason
  details      String?
  caseId       String?
  createdAt    DateTime     @default(now())
  reporter     Person       @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  case         ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
}

enum CaseStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
  APPEALED
}

model ModerationCase {
  id              String     @id @default(cuid())
  targetType      String
  targetId        String
  subjectPersonId String?
  subjectOrgId    String?
  status          CaseStatus @default(OPEN)
  reason          ReportReason
  reportCount     Int        @default(1)
  signals         Json?
  assignedToId    String?
  resolvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  reports         Report[]
  actions         ModerationAction[]
  subjectPerson   Person?    @relation("CaseSubjectPerson", fields: [subjectPersonId], references: [id], onDelete: SetNull)
  subjectOrg      Organization? @relation("CaseSubjectOrg", fields: [subjectOrgId], references: [id], onDelete: SetNull)

  /// NOT @@unique — a target can rack up several ACTIONED/DISMISSED cases over its
  /// lifetime; the real "one open case per target" rule is the partial unique index
  /// `ModerationCase_one_open_per_target` (status IN ('OPEN','IN_REVIEW')) added by
  /// migration 20260918150000_moderation_case_status_index_fix. A plain @@unique on
  /// (targetType, targetId, status) would also forbid a SECOND resolved case ever
  /// reaching the same status, which moderation.ts hits on every repeat offender.
  @@index([targetType, targetId, status])
  @@index([status, createdAt])
}

enum ModerationActionKind {
  WARN
  RESTRICT_OUTREACH
  REMOVE_CONTENT
  SUSPEND
  BAN
  DISMISS
  APPEAL_GRANTED
  APPEAL_DENIED
  NOTE
}

model ModerationAction {
  id          String               @id @default(cuid())
  caseId      String
  moderatorId String
  kind        ModerationActionKind
  note        String
  /// Plain-English version the user sees.
  userMessage String?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  case        ModerationCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model Restriction {
  id        String   @id @default(cuid())
  personId  String
  kind      String
  reason    String
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([personId, kind, expiresAt])
}

model Appeal {
  id        String    @id @default(cuid())
  personId  String
  actionId  String
  body      String
  decidedAt DateTime?
  decision  String?
  createdAt DateTime  @default(now())

  @@index([personId])
}

/// Platform staff (moderators/admins) — separate from Person so it can be
/// granted to a Loopcom SUPER_ADMIN via SSO or to a dedicated moderator.
model StaffGrant {
  personId  String   @id
  role      String   @default("MODERATOR")
  grantedById String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorLabel     String?
  action         String
  targetType     String
  targetId       String?
  organizationId String?
  before         Json?
  after          Json?
  source         String   @default("api")
  ip             String?
  createdAt      DateTime @default(now())
  actor          Person?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

/// Idempotency-Key replay store (24h).
model IdempotencyKey {
  key        String   @id
  personId   String
  method     String
  path       String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Anti-spam counters, explainable per signal.
model OutreachStat {
  personId          String   @id
  messagesLast24h   Int      @default(0)
  requestsLast24h   Int      @default(0)
  connectionsSent7d Int      @default(0)
  acceptedRate      Float    @default(0)
  blockCount        Int      @default(0)
  reportCount       Int      @default(0)
  duplicateRatio    Float    @default(0)
  windowStart       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Dev/test mailbox — only written when COMMUNITY_MAIL_MODE=mailbox.
model OutboundMail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String?
  channel   String   @default("email")
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}
