  target       Person?     @relation("IntroTarget", fields: [targetPersonId], references: [id], onDelete: Cascade)

  @@index([middleId, status])
  @@index([requesterId])
}

// ───────────────────────────── Mini CRM (private) ─────────────────────────────

model PrivateNote {
  id             String   @id @default(cuid())
  ownerId        String
  targetPersonId String?
  targetOrgId    String?
  body           String
  tags           String[]
  dealValue      Decimal? @db.Decimal(12, 2)
  nextAction     String?
  nextActionAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          Person   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, targetPersonId])
  @@index([ownerId, targetOrgId])
}

model Reminder {
  id             String    @id @default(cuid())
  ownerId        String
  targetPersonId String?
  targetOrgId    String?
  title          String
  dueAt          DateTime
  doneAt         DateTime?
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())
