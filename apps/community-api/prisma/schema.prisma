model AnalyticsDaily {
  day        DateTime @db.Date
  objectType String
  objectId   String
  event      String
  count      Int      @default(0)

  @@id([day, objectType, objectId, event])
}

model RecommendationImpression {
  id        String   @id @default(cuid())
  personId  String
  surface   String
  model     String
  objectType String
  objectId  String
  reason    String?
  position  Int?
  outcome   String?
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
  @@index([objectType, objectId])
}

model FeatureFlag {
  key          String   @id
  description  String?
  enabled      Boolean  @default(false)
  rollout      Int      @default(0)
  audience     String   @default("INTERNAL")
  allowPersons String[]
  allowOrgs    String[]
  updatedById  String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Experiment {
  id           String   @id @default(cuid())
  key          String   @unique
  hypothesis   String
  population   String
  treatment    String
  control      String
  successMetrics String[]
  guardrailMetrics String[]
  minSample    Int      @default(100)
  rollbackCriteria String?
  startsAt     DateTime?
  endsAt       DateTime?
  status       String   @default("DRAFT")
  createdById  String?
  createdAt    DateTime @default(now())
