# Copy to .env. The database is Community's OWN — never point this at connectcomms.
COMMUNITY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/loopcom_community
# >= 32 chars. Signs access tokens (15 min) — refresh tokens are opaque DB rows.
COMMUNITY_JWT_SECRET=
COMMUNITY_PUBLIC_URL=http://localhost:3100
COMMUNITY_API_URL=http://localhost:3101
PORT=3101
# mailbox = write outbound mail to the OutboundMail table (dev/test); smtp = real SMTP below
COMMUNITY_MAIL_MODE=mailbox
SMTP_URL=
MAIL_FROM="Loopcom Community <community@loopcom.net>"
# local disk in dev; S3 when COMMUNITY_S3_BUCKET is set
COMMUNITY_STORAGE_DIR=./.storage
COMMUNITY_S3_BUCKET=
COMMUNITY_S3_REGION=
COMMUNITY_S3_ENDPOINT=
# Loopcom (Connect) api used to verify SSO tokens — the ONLY integration point
LOOPCOM_API_URL=https://app.loopcom.net/api
# Optional Redis for realtime fan-out across instances; in-process bus when unset
REDIS_URL=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3100
NODE_ENV=development
