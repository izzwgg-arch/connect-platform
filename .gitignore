# build outputs
dist/
build/
.out/
.next/
.turbo/
coverage/

# logs
logs/
*.log

# env
.env
.env.*
!/apps/**/.env.example
!/packages/**/.env.example
# Local-only secrets for PBX↔Connect observation script (see scripts/pbx-connect-observe.env.example)
scripts/pbx-connect-observe.env

# docker
node_modules/
**/node_modules/

# prisma artifacts (keep migrations)
prisma/dev.db

# workspace/generated artifacts
node_modules
**/node_modules
.next
**/.next
dist
**/dist
build
**/build
.turbo
**/.turbo
coverage
**/coverage
.pnpm-store
**/.pnpm-store
ops/logs
**/ops/logs
ops/snapshots
**/ops/snapshots
**/*.log

# SSH keys for server access (NEVER commit private keys)
.connect-ssh/

# local DB repair scratch (do not ship)
tmp-link-repair-*.sql

# diagnostic/temp folders (do not ship)
_tmp_diag/
_tmp_*/

# Local server health reports (read-only diagnostics, never committed)
_server_reports/

# Ad-hoc debug artifacts (screenshots, logcat dumps, APKs, scratch scripts).
# Not source, and large binaries here were bloating EAS Build uploads to
# 700+ MB (EAS falls back to .gitignore rules when no .easignore exists).
_latency_logs/
# docs/ used to be ignored WHOLESALE because docs/pbx-brain/ holds a 1.2 GB
# PBX snapshot that bloated EAS uploads — which silently left 41 of 91 handoff
# docs (several of them CLAUDE.md "READ FIRST" targets) out of git entirely.
# EAS is protected by .easignore (which still excludes all of docs/); git now
# ignores only the snapshot. (2026-08-12)
docs/pbx-brain/
apps/portal/public/downloads/
_latency_logs/
/*.txt

# cowork (2026-07-13): large non-source dirs bloating EAS build tarball to 1.6GB+
_repo_archive/
_moh_safety_backup/
_moh_catalog_clean/
_moh_worktree/
_pbx_installers/
cb17/
cb18/
cb19/

# Python bytecode (scripts/pbx helper runs)
__pycache__/
*.pyc

# Patch/merge artifacts (2026-08-19). A 1.9 MB `apps/api/src/server.ts.orig`
# sat untracked in the shared tree for a day and was one blanket `git add -A`
# away from being committed over the real file.
*.orig
*.rej

# Yiddish scratch + Kaggle staging (2026-09-18). scripts/.tmp holds one-off
# probe scripts and the harvested-article JSONL; kernel-log is whatever the
# training watcher last pulled back from Kaggle; code-dataset/ mirrors
# train.py + baseline.py purely so `kaggle datasets version` has a folder to
# upload -- nothing in it is a source of truth.
# (Its dataset-metadata.json is already ignored by scripts/yiddish-finetune/.gitignore,
# so do not add a negation here: it would look like it tracks the file and would not.)
scripts/.tmp/
scripts/yiddish-finetune/kernel-log/
scripts/yiddish-finetune/code-dataset/
scripts/yiddish-finetune/*.log
scripts/yiddish-labelling/*.log
scripts/yiddish-labelling/batches/
scripts/yiddish-finetune/dataset/
