# ⛔ These files are copied to a Linux server. A CRLF checkout on Windows
# breaks a shell script (bad interpreter) and can break nginx includes.
# Same reason /scripts/pbx/** is pinned in the repo-root .gitattributes.
*.sh        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.xml       text eol=lf
*.txt       text eol=lf
*.webmanifest text eol=lf
