{
  "name": "loopcom-support-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LoopCom support escalations in a Claude Code session: read tickets, act as the ticket's filer through the api, text the owner first.",
  "main": "server.mjs",
  "scripts": {
